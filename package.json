{
  "name": "aurora-demo-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Demo backend for prod Aurora/Halo (legacy horizont protocol) on fixtures",
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "test": "node --test test/*.test.mjs",
    "test:watch": "node --test --watch test/*.test.mjs",
    "fixtures": "python3 scripts/build-fixtures.py",
    "test:aurora": "npm --prefix aurora-vue2-tests test",
    "coverage:aurora": "npm --prefix aurora-vue2-tests run coverage",
    "test:aurora3": "npm --prefix aurora-vue3-tests test",
    "test:e2e": "playwright test",
    "test:e2e:vue2": "playwright test --project=vue2",
    "test:e2e:vue3": "playwright test --project=vue3",
    "check:schemas": "node scripts/check-schemas.mjs --all",
    "check:schemas:errors": "node scripts/check-schemas.mjs",
    "test:e2e:adversarial": "playwright test e2e/09-adversarial-schemas.spec.mjs",
    "test:e2e:halo": "playwright test --config playwright.halo.config.mjs",
    "test:validation": "node --test test/validation.test.mjs",
    "typecheck:validation": "tsc -p tsconfig.validation.json"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "typescript": "^5.9.3"
  }
}
