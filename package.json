{
  "name": "aurora-demo-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Demo backend for prod Aurora/Halo (legacy horizont protocol) on fixtures",
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "test": "node --test test/*.test.mjs",
    "test:watch": "node --test --watch test/*.test.mjs",
    "fixtures": "python3 scripts/build-fixtures.py",
    "test:aurora": "npm --prefix aurora-vue2-tests test",
    "coverage:aurora": "npm --prefix aurora-vue2-tests run coverage",
    "test:aurora3": "npm --prefix aurora-vue3-tests test"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "fastify": "^5.2.1"
  }
}
