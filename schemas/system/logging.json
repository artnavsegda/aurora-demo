{
  "$schema": "http://json-schema.org/schema#",
  "documentation": [
    "local",
    "global"
  ],
  "title": "Logging",
  "description": "Setting up logging",
  "type": "object",
  "properties": {
    "remote": {
      "type": "array",
      "title": "Remote servers",
      "uniqueItems": true,
      "description": "Remote syslog servers as address:port/protocol. Every server receives every log record. TCP uses octet-counting framing (RFC 6587)",
      "items": {
        "type": "string",
        "pattern": "^(\\[[0-9A-Fa-f:.]+\\]|[^\\[\\]:/ ]+):(?![7-9]\\d{4})(?!6[6-9]\\d{3})(?!65[6-9]\\d{2})(?!655[4-9]\\d)(?!6553[6-9])(?!0+/)([0-9]{1,5})/(tcp|udp)$",
        "patternDescription": "Address, port and protocol (tcp or udp)",
        "patternExample": [
          "192.168.1.100:514/udp",
          "192.168.1.100:514/tcp",
          "log.example.com:6514/tcp"
        ]
      }
    },
    "hostname": {
      "type": "string",
      "title": "Hostname (prefix) override",
      "description": "Hostname placed in every message. Empty means the device hostname"
    },
    "format": {
      "type": "string",
      "title": "Message format",
      "enum": [
        "rfc3164",
        "rfc5424"
      ],
      "strictEnum": true,
      "default": "rfc5424",
      "description": "Wire format: RFC 3164 (BSD syslog) or RFC 5424"
    },
    "buffer": {
      "type": "boolean",
      "title": "Accumulate buffer",
      "default": false,
      "description": "Keep messages in memory while a server is unreachable and send them on recovery. Off: messages arriving while a server is unreachable are lost"
    },
    "buffer-size": {
      "type": "number",
      "title": "Buffer size",
      "minimum": 64,
      "maximum": 2048,
      "default": 512,
      "description": "In-memory buffer size in KB. On overflow the oldest messages are dropped",
      "hidden": true,
      "modificator": [
        {
          "if": [
            {
              "buffer": true
            }
          ],
          "then": {
            "hidden": false
          }
        }
      ]
    },
    "file-log": {
      "$ref": "/defaults#/definitions/disabled",
      "title": "Log to file",
      "description": "Enable logging to local file"
    },
    "file-name": {
      "type": "string",
      "title": "File",
      "description": "Log file name",
      "default": "syslog",
      "hidden": true,
      "modificator": [
        {
          "if": [
            {
              "file-log": true
            }
          ],
          "then": {
            "hidden": false
          }
        }
      ]
    },
    "file-size": {
      "type": "number",
      "default": 64,
      "minimum": 2,
      "maximum": 8192,
      "title": "File size",
      "description": "Maximum total size (Kbyte) of the log file and its .old copy",
      "hidden": true,
      "modificator": [
        {
          "if": [
            {
              "file-log": true
            }
          ],
          "then": {
            "hidden": false
          }
        }
      ]
    }
  },
  "apply": {
    "exec": "subscript/system/logging.uc",
    "args": [
      "apply"
    ],
    "reload": true
  },
  "status": {
    "exec": "subscript/system/logging.uc",
    "args": [
      "status"
    ]
  },
  "set": {
    "exec": "subscript/system/logging.uc",
    "args": [
      "set"
    ]
  },
  "acquire": {
    "exec": "subscript/system/logging.uc",
    "args": [
      "get"
    ]
  }
}