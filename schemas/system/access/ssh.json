{
  "$schema": "http://json-schema.org/schema#",
  "documentation": [
    "local",
    "global"
  ],
  "title": "SSH server",
  "description": "Secure Shell (SSH) server access configuration",
  "type": "object",
  "required": [
    "port"
  ],
  "properties": {
    "disabled": {
      "$ref": "/defaults#/definitions/disabled"
    },
    "port": {
      "$ref": "/defaults#/definitions/port-strict",
      "description": "Secure Shell (SSH) service listening port"
    },
    "cipher": {
      "type": "array",
      "title": "Cipher",
      "description": "Secure Shell (SSH) encryption cipher selection",
      "items": {
        "type": "string",
        "enum": [
          "aes256-gcm@openssh.com",
          "aes128-gcm@openssh.com",
          "aes256-ctr",
          "aes192-ctr",
          "aes128-ctr"
        ]
      }
    },
    "host-key-alg": {
      "title": "Host Key Algorithms",
      "description": "Secure Shell (SSH) host key algorithm selection",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "ssh-ed25519",
          "rsa-sha2-512",
          "rsa-sha2-256"
        ]
      }
    },
    "kex-alg": {
      "title": "KEX Algorithms",
      "description": "Secure Shell (SSH) key exchange method selection",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "mlkem768x25519-sha256",
          "sntrup761x25519-sha512",
          "sntrup761x25519-sha512@openssh.com",
          "curve25519-sha256",
          "curve25519-sha256@libssh.org",
          "diffie-hellman-group18-sha512",
          "diffie-hellman-group16-sha512"
        ]
      }
    },
    "mac-alg": {
      "title": "MAC Algorithms",
      "description": "Secure Shell (SSH) Message Authentication Code (MAC) algorithm selection",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "hmac-sha2-512-etm@openssh.com",
          "hmac-sha2-256-etm@openssh.com",
          "hmac-sha2-512",
          "hmac-sha2-256"
        ]
      }
    },
    "use-banner": {
      "type": "boolean",
      "title": "Show Banner",
      "description": "Show device information before auth"
    }
  },
  "apply": {
    "exec": "subscript/system/access-ssh.uc",
    "args": [
      "apply"
    ]
  },
  "status": {
    "exec": "subscript/system/access-ssh.uc",
    "args": [
      "status"
    ]
  },
  "set": {
    "exec": "subscript/system/access-ssh.uc",
    "args": [
      "set"
    ]
  },
  "acquire": {
    "exec": "subscript/system/access-ssh.uc",
    "args": [
      "get"
    ]
  }
}