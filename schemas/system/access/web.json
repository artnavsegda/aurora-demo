{
    "$schema": "http://json-schema.org/schema#",
    "documentation": ["local", "global"],
    "title": "WEB-server",
    "description": "Web Interface settings",
    "type": "object",
    "required": ["cert"],
    "properties": {
        "use-http": {
            "title": "Use HTTP",
            "description": "Enable HTTP access to allow unencrypted web interface connections",
            "type": "boolean"
        },

        "http-port": {
            "$ref": "/defaults#/definitions/port",
            "description": "HTTP listening port for incoming connection requests",
            "title": "HTTP Port",
            "default": 80,
            "hidden": true,
            "modificator": [
                {"if": [{"use-http": "true"}], "then": {"hidden": false}}
            ]
        },

        "use-https": {
            "title": "Use HTTPS",
            "type": "boolean",
            "description": "Enable HTTPS access to secure web interface connections"
        },

        "https-port": {
            "$ref": "/defaults#/definitions/port",
            "description": "HTTPS listening port for encrypted connection requests",
            "title": "HTTPS Port",
            "default": 443,
            "hidden": true,
            "modificator": [
                {"if": [{"use-https": "true"}], "then": {"hidden": false}}
            ]
        },

        "cert": {
            "$ref": "/defaults#/definitions/cert",
            "title": "Certificate",
            "hidden": true,
            "modificator": [
                {"if": [{"use-https": "true"}], "then": {"hidden": false}}
            ]
        },

        "tls": {
            "type": "string",
            "enum": ["1.1", "1.2", "1.3"],
            "title": "Min TLS-version",
            "description": "Minimum allowed TLS version for secure protocol negotiation",
            "hidden": true,
            "modificator": [
                {"if": [{"use-https": "true"}], "then": {"hidden": false}}
            ]
        },
        
        "redirect-to-https": {
            "title": "Redirect to HTTPS",
            "description": "Redirect HTTP traffic to HTTPS port for enforced encryption",
            "type": "boolean",
            "hidden": true,
            "modificator": [
                {"if": [{"use-https": "true"}, {"use-http": "true"}], "then": {"hidden": false}}
            ]
        }
    },

    "apply": {
        "exec": "subscript/system/access-web.uc",
        "args": ["apply"]
    },

    "status": {
        "exec": "subscript/system/access-web.uc",
        "args": ["status"]
    },

    "set": {
        "exec": "subscript/system/access-web.uc",
        "args": ["set"]
    },
    
    "acquire": {
        "exec": "subscript/system/access-web.uc",
        "args": ["get"]
    }
}
