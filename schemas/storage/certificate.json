{
  "$schema": "http://json-schema.org/schema#",
  "documentation": [
    "local",
    "global"
  ],
  "title": "certificate",
  "description": "Certificate store for TLS credential management",
  "type": "object",
  "definitions": {
    "name": {
      "$ref": "/defaults#/definitions/name-ext",
      "description": "Certificate file name",
      "title": "File Name"
    },
    "ca": {
      "$ref": "/defaults#/definitions/ca",
      "title": "CA Certificate",
      "cue": [
        "/storage/certificate[priv-key:true]"
      ]
    },
    "authority": {
      "type": "boolean",
      "title": "CA flag",
      "description": "The certificate can be used to sign"
    },
    "common-name": {
      "$ref": "/defaults#/definitions/name-spaces",
      "description": "Certificate common name",
      "title": "Common Name",
      "minLength": 1,
      "maxLength": 64
    },
    "alt-name": {
      "type": "string",
      "description": "Certificate subject alternative name",
      "example": [
        "hostname",
        "192.168.1.1",
        "email@example.com",
        "hostname,192.168.1.1,email@example.com"
      ],
      "title": "Alternative Name",
      "pattern": "^.*$",
      "patternDescription": "Alternative Names separated by commas",
      "patternExample": [
        "mail@examle.com",
        "192.168.1.1",
        "mail@examle.com,192.168.1.1,example.com"
      ]
    },
    "org": {
      "$ref": "/defaults#/definitions/name-spaces",
      "description": "Subject organization",
      "title": "Organization Name"
    },
    "unit": {
      "$ref": "/defaults#/definitions/name-spaces",
      "description": "subject organizational unit",
      "title": "Organization unit"
    },
    "state": {
      "$ref": "/defaults#/definitions/name-spaces",
      "description": "Subject state"
    },
    "country": {
      "$ref": "/defaults#/definitions/name-spaces",
      "description": "Subject country"
    },
    "location": {
      "$ref": "/defaults#/definitions/name-spaces",
      "description": "Subject location"
    },
    "key-usage": {
      "type": "array",
      "description": "Key Usage extension",
      "title": "Key Usage",
      "items": {
        "type": "string",
        "enum": [
          "digital-signature",
          "key-encipherment",
          "key-agreement",
          "key-cert-sign",
          "crl-sign",
          "encipher-only",
          "decipher-only",
          "data-encipherment",
          "non-repudiation"
        ]
      }
    },
    "eku": {
      "type": "array",
      "description": "Extended Key Usage purposes",
      "title": "Extended Key Usage",
      "items": {
        "type": "string",
        "enum": [
          "server-auth",
          "client-auth",
          "ocsp-signing",
          "time-stamping"
        ]
      }
    }
  },
  "noExport": true,
  "showParams": [
    "state",
    "subject",
    "issuer",
    "alt-name",
    "pub-key",
    "priv-key"
  ],
  "patternProperties": {
    ".*": {
      "type": "object",
      "properties": {
        "issuer": {
          "type": "array",
          "readOnly": true,
          "items": {
            "enum": []
          },
          "description": "The issuer name"
        },
        "subject": {
          "type": "array",
          "readOnly": true,
          "items": {
            "enum": []
          },
          "description": "The subject name"
        },
        "authority": {
          "$ref": "#/definitions/authority",
          "readOnly": true
        },
        "alt-name": {
          "type": "array",
          "readOnly": true,
          "description": "The subject alternative name",
          "modificator": [
            {
              "if": [
                {
                  "alt-name": "!"
                }
              ],
              "then": {
                "items": {
                  "enum": []
                }
              }
            }
          ]
        },
        "not-before": {
          "type": "string",
          "readOnly": true,
          "description": "The date before which certificate is invalid"
        },
        "not-after": {
          "type": "string",
          "readOnly": true,
          "description": "The date after which certificate wil be invalid"
        },
        "fingerprint": {
          "type": "string",
          "readOnly": true,
          "description": "The certificate hash"
        },
        "priv-key": {
          "type": "boolean",
          "hidden": true,
          "readOnly": true,
          "description": "The private key file"
        },
        "key-usage": {
          "$ref": "#/definitions/key-usage",
          "readOnly": true
        },
        "eku": {
          "$ref": "#/definitions/eku",
          "readOnly": true
        }
      }
    },
    "actions": {
      "rename": {
        "exec": "subscript/storage/certificate.uc",
        "args": [
          "rename"
        ],
        "description": "Rename certificate file for organizational purposes",
        "reload": true,
        "schema": {
          "required": [
            "new-name"
          ],
          "properties": {
            "new-name": {
              "title": "new name",
              "$ref": "#/definitions/name",
              "description": "New filename for certificate storage"
            }
          }
        }
      },
      "reissue": {
        "exec": "subscript/storage/certificate.uc",
        "args": [
          "reissue"
        ],
        "description": "Reissue certificate with updated Key Usage and Extended Key Usage",
        "reload": true,
        "schema": {
          "required": [
            "key-usage"
          ],
          "properties": {
            "key-usage": {
              "$ref": "#/definitions/key-usage"
            },
            "eku": {
              "$ref": "#/definitions/eku"
            }
          }
        }
      }
    }
  },
  "actions": {
    "cert-create": {
      "title": "Cert Create",
      "exec": "subscript/storage/certificate.uc",
      "args": [
        "create_x509"
      ],
      "description": "Generate certificate for secure service authentication",
      "schema": {
        "required": [
          "name",
          "cn"
        ],
        "properties": {
          "name": {
            "$ref": "#/definitions/name",
            "description": "New filename for certificate storage"
          },
          "ca": {
            "$ref": "#/definitions/ca"
          },
          "authority": {
            "$ref": "#/definitions/authority",
            "hidden": true,
            "modificator": [
              {
                "if": [
                  {
                    "ca": "!"
                  }
                ],
                "then": {
                  "hidden": false
                }
              }
            ]
          },
          "pkey-size": {
            "type": "string",
            "description": "Private key size to configure cryptographic strength",
            "enum": [
              "1024",
              "1536",
              "2048",
              "4096",
              "8192",
              "prime256v1",
              "secp384r1",
              "secp521r1"
            ]
          },
          "cn": {
            "$ref": "#/definitions/common-name"
          },
          "alt-name": {
            "$ref": "#/definitions/alt-name"
          },
          "org": {
            "$ref": "#/definitions/org"
          },
          "unit": {
            "$ref": "#/definitions/unit"
          },
          "state": {
            "$ref": "#/definitions/state"
          },
          "country": {
            "$ref": "#/definitions/country"
          },
          "location": {
            "$ref": "#/definitions/location"
          },
          "days": {
            "type": "number",
            "description": "Certificate validity period for expiration management",
            "default": 365,
            "minimum": 1
          },
          "key-usage": {
            "hidden": true,
            "noExport": true,
            "$ref": "#/definitions/key-usage"
          },
          "eku": {
            "hidden": true,
            "noExport": true,
            "$ref": "#/definitions/eku"
          }
        }
      }
    },
    "csr-create": {
      "title": "CSR create",
      "exec": "subscript/storage/certificate.uc",
      "args": [
        "create_csr"
      ],
      "description": "Generate Certificate Signing Request (CSR) file for third-party validation",
      "schema": {
        "required": [
          "name",
          "cn"
        ],
        "properties": {
          "name": {
            "$ref": "#/definitions/name",
            "description": "CSR filename for signing request identification"
          },
          "pkey-size": {
            "type": "string",
            "description": "Public key size to match cryptographic key pair",
            "enum": [
              "1024",
              "1536",
              "2048",
              "4096",
              "8192",
              "prime256v1",
              "secp384r1",
              "secp521r1"
            ]
          },
          "passphrase": {
            "$ref": "/defaults#/definitions/password",
            "minLength": 8,
            "description": "Certificate file passphrase to encrypt private key storage"
          },
          "cn": {
            "$ref": "#/definitions/common-name"
          },
          "alt-name": {
            "$ref": "#/definitions/alt-name"
          },
          "org": {
            "$ref": "#/definitions/org"
          },
          "unit": {
            "$ref": "#/definitions/unit"
          },
          "state": {
            "$ref": "#/definitions/state"
          },
          "country": {
            "$ref": "#/definitions/country"
          },
          "location": {
            "$ref": "#/definitions/location"
          },
          "key-usage": {
            "hidden": true,
            "noExport": true,
            "$ref": "#/definitions/key-usage"
          },
          "eku": {
            "hidden": true,
            "noExport": true,
            "$ref": "#/definitions/eku"
          }
        }
      }
    },
    "csr-sign": {
      "title": "CSR sign",
      "exec": "subscript/storage/certificate.uc",
      "args": [
        "sign"
      ],
      "description": "Sign Certificate Signing Request to validate domain ownership",
      "schema": {
        "required": [
          "name",
          "ca"
        ],
        "properties": {
          "name": {
            "description": "Certificate Signing Request file for authority validation",
            "cue": [
              "/storage/file"
            ]
          },
          "ca": {
            "$ref": "#/definitions/ca"
          },
          "alt-name": {
            "$ref": "#/definitions/alt-name"
          },
          "days": {
            "type": "number",
            "default": 365,
            "minimum": 1,
            "description": "Signed certificate validity period to enforce expiration dates"
          },
          "passphrase": {
            "$ref": "/defaults#/definitions/password",
            "description": "Certificate file passphrase to encrypt private key storage"
          },
          "scep-url": {
            "hidden": true,
            "description": "SCEP directory url"
          },
          "key-usage": {
            "hidden": true,
            "noExport": true,
            "$ref": "#/definitions/key-usage"
          },
          "eku": {
            "hidden": true,
            "noExport": true,
            "$ref": "#/definitions/eku"
          }
        }
      }
    },
    "cert-export": {
      "title": "Cert Export",
      "exec": "subscript/storage/certificate.uc",
      "args": [
        "cert_export"
      ],
      "description": "Export certificate bundle as PKCS#12 or PEM for backup or migration",
      "schema": {
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "description": "Certificate file for export",
            "cue": [
              "/storage/certificate"
            ]
          },
          "include-pkey": {
            "type": "boolean",
            "title": "Include Privkey",
            "description": "Export with private-key"
          },
          "passphrase": {
            "$ref": "/defaults#/definitions/password",
            "minLength": 8,
            "description": "Passphrase for the certificate file"
          },
          "additional-cert": {
            "type": "array",
            "title": "Additional Cert",
            "description": "Include additional certificate",
            "items": {
              "type": "string",
              "cue": [
                "/storage/certificate"
              ]
            }
          },
          "pem": {
            "type": "boolean",
            "title": "Export as PEM",
            "description": "Export as plain PEM file instead of PKCS#12 container"
          }
        }
      }
    },
    "cert-import": {
      "title": "Cert Import",
      "exec": "subscript/storage/certificate.uc",
      "args": [
        "cert_import"
      ],
      "description": "Import certificate file with optional name and decryption passphrase",
      "schema": {
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "description": "Certificate file to import for TLS configuration",
            "cue": [
              "/storage/file"
            ]
          },
          "passphrase": {
            "$ref": "/defaults#/definitions/password",
            "description": "Certificate file passphrase to encrypt private key storage"
          }
        }
      }
    }
  },
  "acquire": {
    "exec": "subscript/storage/certificate.uc",
    "args": [
      "get"
    ]
  },
  "clean": {
    "exec": "subscript/storage/certificate.uc",
    "args": [
      "clean"
    ],
    "confirm": true,
    "reload": true
  },
  "delete": {
    "exec": "subscript/storage/certificate.uc",
    "args": [
      "delete"
    ],
    "reload": true
  }
}