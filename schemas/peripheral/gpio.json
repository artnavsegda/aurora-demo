{
  "$schema": "http://json-schema.org/schema#",
  "documentation": ["local", "global"],
  "title": "io",
  "description": "General-Purpose I/O",
  "type": "object",
  "namesake": "name",
  "noCache": true,
  "showParams": ["state", "direction", "value"],
  "patternProperties": {
    ".*": {
      "type": "object",
      "title": "GPIO name",
      "properties": {
        ".type": {
          "type": "string",
          "hidden": true,
          "readOnly": true,
          "noExport": true,
          "description": "the secret value for modificator in 'direction'",
          "items": {
            "type": "string"
          }
        },

        "direction": {
          "type": "string",
          "title": "Direction",
          "description": "Port operating mode",
          "strictEnum": true,
          "enum": ["in", "out"],
          "modificator": [
            {"if": [{".type": "gpi"}], "then": {"enum": ["in"]}},
            {"if": [{".type": "gpo"}], "then": {"enum": ["out"]}}
          ]
        },

        "value": {
          "type": "string",
          "title": "Value",
          "description": "Voltage level on the port",
          "enum": ["high", "low"],
          "readOnly": false,
          "modificator": [
            {"if":[{"direction": "in"}], "then": {"readOnly": true}}
          ]
        },
    
        "trigger": {
          "type": "string",
          "title": "Trigger",
          "description": "Edge-triggered event generation",
          "enum": ["none", "rising", "falling", "both"],
          "hidden": true,
          "modificator": [
            {"if":[{"direction": "in"}], "then": {"hidden": false}}
          ]
        },
    
        "debounce": {
          "type": "number",
          "title": "Debounce",
          "description": "Contact debounce interval (msec)",
          "default": "100",
          "hidden": true,
          "modificator": [
            {"if":[{"direction": "in"}], "then": {"hidden": false}}
          ]
        }

      }
    }
  },

  "apply": {
      "exec": "subscript/peripheral/gpio.uc",
      "args": ["apply"]
  },

  "set": {
    "exec": "subscript/peripheral/gpio.uc",
    "args": ["set"]
  },    

  "acquire": {
    "exec": "subscript/peripheral/gpio.uc",
    "args": ["get"]
  }
}
