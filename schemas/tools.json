{
  "$schema": "http://json-schema.org/schema#",
  "documentation": [
    "local",
    "global"
  ],
  "title": "Tools",
  "type": "object",
  "decription": "System utilities and diagnostic tools",
  "noExport": true,
  "definitions": {
    "local-ip": {
      "$ref": "/defaults#/definitions/interface-ipaddr",
      "title": "Local IP",
      "description": "Local source address or interface"
    },
    "count": {
      "type": "number",
      "minimum": 1,
      "default": 10,
      "description": "Number of packets to send"
    }
  },
  "actions": {
    "download": {
      "description": "Upload file to device storage",
      "exec": "subscript/tools/download.uc",
      "args": [
        "run"
      ],
      "wait": true,
      "schema": {
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "description": "Resource URL",
            "title": "URL"
          },
          "to-file": {
            "$ref": "/defaults#/definitions/name-ext",
            "description": "Save file with specified filename",
            "title": "To file"
          },
          "username": {
            "$ref": "/defaults#/definitions/username",
            "description": "Username for authentication"
          },
          "password": {
            "$ref": "/defaults#/definitions/password",
            "description": "Password for authentication"
          },
          "save": {
            "type": "boolean",
            "description": "Save file to permanent storage",
            "title": "Save to storage"
          }
        }
      }
    },
    "ping": {
      "exec": "subscript/tools/ping.uc",
      "args": [
        "run"
      ],
      "description": "ICMP echo requests to remote host",
      "wait": true,
      "schema": {
        "required": [
          "host"
        ],
        "properties": {
          "host": {
            "$ref": "/defaults#/definitions/host"
          },
          "local-ip": {
            "$ref": "#/definitions/local-ip"
          },
          "count": {
            "$ref": "#/definitions/count"
          },
          "size": {
            "type": "number",
            "minimum": 8,
            "default": 64,
            "description": "Packet size"
          }
        }
      }
    },
    "sniffer": {
      "exec": "subscript/tools/sniffer.uc",
      "args": [
        "run"
      ],
      "description": "Network packet analyzer",
      "wait": true,
      "schema": {
        "required": [
          "interface"
        ],
        "properties": {
          "interface": {
            "strictEnum": true,
            "$ref": "/defaults#/definitions/interface",
            "description": "Packet capture interface"
          },
          "proto": {
            "type": "string",
            "title": "Protocol",
            "enum": [
              "arp",
              "aarp",
              "rarp",
              "ip",
              "ip6",
              "ipx",
              "icmp",
              "igmp",
              "tcp",
              "udp",
              "esp",
              "vlan",
              "stp",
              "pppoed",
              "pppoes",
              "mpls"
            ],
            "strictEnum": true,
            "default": "none",
            "description": "Protocol filter"
          },
          "host": {
            "$ref": "/defaults#/definitions/host-cidr",
            "enableInvert": true,
            "description": "Source or destination host or network filter",
            "pattern": "(^!?([01]?\\d\\d?|2[0-4]\\d|25[0-5])(\\.([01]?\\d\\d?|2[0-4]\\d|25[0-5])){3}(\\/([0-2]?\\d|3[0-2]))?$)|(^!?(?!-)(?:(?:(?:(?:\\d?[A-Za-z-])|(?:[A-Za-z]))[A-Za-z-\\d]*(?:(?:[A-Za-z]*\\d)|(?:[A-Za-z])?)|\\d+)\\.*)*(?:(?:(?:\\d?[A-Za-z-])|(?:[A-Za-z]))[A-Za-z-\\d]*(?:(?:[A-Za-z]*\\d)|(?:[A-Za-z])))$)",
            "patternDescription": "Host address (FQDN or CIDR address)",
            "patternExample": [
              "localhost",
              "sample.example.com",
              "8.8.8.8",
              "192.168.1.0/24",
              "!192.168.1.0/24"
            ]
          },
          "port": {
            "$ref": "/defaults#/definitions/port",
            "enableInvert": true,
            "description": "Source or destination port filter"
          },
          "mac": {
            "type": "string",
            "title": "MAC",
            "description": "Source or destination MAC address filter",
            "enableInvert": true,
            "pattern": "^!?((\\d|[a-fA-F]){2}:){5}(\\d|[a-fA-F]){2}$",
            "patternDescription": "MAC address",
            "patternExample": [
              "ff:ff:ff:ff:ff:ff",
              "BE:AF:CO:OF:FE:E0"
            ]
          },
          "count": {
            "$ref": "#/definitions/count"
          },
          "file": {
            "type": "string",
            "description": "File name for packet dump",
            "pattern": "^[a-zA-Z0-9\\_\\-\\.]+$",
            "patternDescription": "Letters, digits and symbols: _-."
          }
        }
      }
    },
    "arping": {
      "exec": "subscript/tools/arping.uc",
      "args": [
        "run"
      ],
      "description": "ARP requests to remote host",
      "wait": true,
      "schema": {
        "required": [
          "host",
          "local-ip"
        ],
        "properties": {
          "host": {
            "$ref": "/defaults#/definitions/host"
          },
          "local-ip": {
            "$ref": "#/definitions/local-ip"
          },
          "count": {
            "$ref": "#/definitions/count"
          }
        }
      }
    },
    "traceroute": {
      "exec": "subscript/tools/traceroute.uc",
      "args": [
        "run"
      ],
      "wait": true,
      "description": "Traceroute to remote host",
      "schema": {
        "required": [
          "host"
        ],
        "properties": {
          "host": {
            "$ref": "/defaults#/definitions/host"
          },
          "local-ip": {
            "$ref": "#/definitions/local-ip"
          },
          "max_hops": {
            "type": "number",
            "description": "Maximum number of hops to host",
            "title": "Maximum hops",
            "minimum": 1,
            "maximum": 255,
            "default": 30
          },
          "protocol": {
            "type": "string",
            "description": "ICMP echo or UDP datagrams",
            "enum": [
              "udp"
            ],
            "default": "icmp",
            "strictEnum": true
          },
          "port": {
            "type": "number",
            "minimum": 1,
            "maximum": 65535,
            "default": 33434,
            "description": "Initial UDP destination port, incremented per probe (UDP protocol only)"
          }
        }
      }
    },
    "resolve": {
      "exec": "subscript/tools/resolve.uc",
      "args": [
        "run"
      ],
      "description": "Query DNS about remote host",
      "wait": true,
      "schema": {
        "required": [
          "host"
        ],
        "properties": {
          "host": {
            "$ref": "/defaults#/definitions/host"
          },
          "dns-server": {
            "title": "DNS server",
            "default": "system",
            "$ref": "/defaults#/definitions/ipaddr-strict"
          },
          "type": {
            "type": "string",
            "title": "Record type",
            "enum": [
              "AAAA",
              "CNAME",
              "MX",
              "NS",
              "PTR",
              "SOA",
              "SRV",
              "TXT"
            ],
            "strictEnum": true,
            "default": "A",
            "description": "DNS record type (default: A for a name, PTR for an IP address)"
          }
        }
      }
    },
    "blink": {
      "exec": "handler",
      "args": [
        "run",
        "tools/blink"
      ],
      "description": "Flashing the power indicator",
      "wait": true,
      "schema": {
        "properties": {
          "duration": {
            "type": "number",
            "description": "Time (sec) to flashing of the power led",
            "title": "Duration",
            "minimim": 1,
            "maximum": 3600,
            "default": 10
          }
        }
      }
    },
    "telnet": {
      "exec": "handler",
      "args": [
        "run",
        "tools/telnet"
      ],
      "description": "Telnet client session to remote host",
      "cliOnly": true,
      "wait": true,
      "schema": {
        "required": [
          "host"
        ],
        "properties": {
          "host": {
            "$ref": "/defaults#/definitions/host"
          },
          "interface": {
            "$ref": "/defaults#/definitions/interface"
          },
          "port": {
            "$ref": "/defaults#/definitions/port"
          }
        }
      }
    },
    "journal": {
      "exec": "subscript/tools/log.uc",
      "args": [
        "run"
      ],
      "description": "View system log entries",
      "cliOnly": true,
      "wait": true,
      "schema": {
        "properties": {
          "filter": {
            "type": "string",
            "description": "Regular expression for filtering output"
          },
          "last": {
            "type": "number",
            "minimum": 1,
            "maximum": 3072,
            "description": "Show last N entries"
          }
        }
      }
    },
    "dashboard": {
      "exec": "dashboard-cli",
      "args": [],
      "description": "System summary",
      "cliOnly": true,
      "wait": true
    },
    "ssh": {
      "exec": "handler",
      "args": [
        "run",
        "tools/ssh"
      ],
      "description": "SSH client session to remote host",
      "cliOnly": true,
      "wait": true,
      "schema": {
        "required": [
          "host",
          "username"
        ],
        "properties": {
          "host": {
            "$ref": "/defaults#/definitions/host"
          },
          "username": {
            "$ref": "/defaults#/definitions/username"
          },
          "port": {
            "$ref": "/defaults#/definitions/port"
          }
        }
      }
    }
  }
}