{
  "$schema": "http://json-schema.org/schema#",
  "documentation": ["local", "global"],
  "title": "OSPF area",
  "type": "object",
  "definitions": {
    "id": {
      "$ref": "/defaults#/definitions/num-or-ipaddr",
      "description": "OSPF Area ID",
      "title": "OSPF Area ID"
    }
  },

  "namesake": "name",
	"patternProperties": {
    ".*": {
      "type": "object",
      "title": "Area entity",
      "required": ["name", "id"],
      "properties": {
        "name": {
          "$ref": "/defaults#/definitions/name",
          "hidden": true
        },
        "id": {
          "$ref": "#/definitions/id"
        },
        "type": {
          "type": "string",
          "description": "Area type",
          "enum": ["standard", "nssa", "stub"]
        },
        "summary": {
          "type": "boolean",
          "description": "Propagate inter-area summary routes (Type-3 Summary LSA) into this area; without it, only a default route is injected (totally stubby)",
          "hidden": true,
          "modificator": [
            {"if": [{"type":"nssa"}], "then": {"hidden": false}},
            {"if": [{"type":"stub"}], "then": {"hidden": false}}
          ]
        },
        "default-nssa": {
          "type": "boolean",
          "description": "Advertise a default route (Type-7) into the NSSA area",
          "hidden": true,
          "modificator": [
            {"if": [{"type":"nssa"}, {"summary": true}], "then": {"hidden": false}}
          ]
        },
        "default-cost": {
          "title": "Default cost",
          "type": "number",
          "description": "Cost for the default route transmitted to the network",
          "minimum": 1,
          "maximum": 16777214,
          "default": 1000,
          "hidden": true,
          "modificator": [
            {"if": [{"type":"nssa"}], "then": {"hidden": false}},
            {"if": [{"type":"stub"}], "then": {"hidden": false}}
          ]
        },
        "default-cost2": {
          "title": "Default cost (type 2)",
          "type": "number",
          "description": "Cost of the NSSA default route as an external Type-2 metric: not added to the internal path cost. When set, it overrides default-cost",
          "minimum": 1,
          "maximum": 16777214,
          "hidden": true,
          "modificator": [
            {"if": [{"type":"nssa"}, {"summary": true}, {"default-nssa": true}], "then": {"hidden": false}}
          ]
        },
        "interface": {
          "type": "array",
          "description": "Area interface",
          "items": {
            "type": "string",
            "cue": ["/routing/ospf/interface"]
          }
        },
        "network": {
          "type": "array",
          "description": "Definition of area IP ranges",
          "items": {
            "type": "string",
            "pattern": "^([01]?\\d\\d?|2[0-4]\\d|25[0-5])(\\.([01]?\\d\\d?|2[0-4]\\d|25[0-5])){3}(\\/(([0-2]?\\d|3[0-2])))(:hidden)?$",
            "patternDescription": "Network address and the optional 'hidden' parameter, separated by a colon",
            "patternExample": ["192.168.1.0/24", "192.168.1.0/24:hidden"]
          }
        },
        "stubnet": {
          "type": "array",
          "description": "Networks that are not transit networks between OSPF routers",
          "items": {
            "type": "string",
            "pattern": "^([01]?\\d\\d?|2[0-4]\\d|25[0-5])(\\.([01]?\\d\\d?|2[0-4]\\d|25[0-5])){3}(\\/(([0-2]?\\d|3[0-2])))(:hidden)?(:summary)?(:(?:0|[1-9]\\d{0,8}|[1-3]\\d{9}|4[0-1]\\d{8}|42[0-8]\\d{7}|429[0-3]\\d{6}|4294[0-8]\\d{5}|42949[0-5]\\d{4}|429496[0-6]\\d{3}|4294967[0-1]\\d{2}|42949672[0-8]\\d|429496729[0-5]))?$",
            "patternDescription": "Network address and optional parameters ['hidden', 'summary', 'cost], separated by a colon. Cost=0-4294967295",
            "patternExample": ["192.168.1.0/24", "192.168.1.0/24:hidden", "192.168.1.0/24:summary", "192.168.1.0/24:10", "192.168.1.0/24:summary:10"]
          }
        },
        "external": {
          "type": "array",
          "description": "Definition of external area IP ranges for NSSAs",
          "hidden": true,
          "modificator": [
            {"if": [{"type": "nssa"}], "then": {"hidden": false}}
          ],
          "items": {
            "type": "string",
            "pattern": "^([01]?\\d\\d?|2[0-4]\\d|25[0-5])(\\.([01]?\\d\\d?|2[0-4]\\d|25[0-5])){3}(\\/(([0-2]?\\d|3[0-2])))(:hidden)?(:(?:0|[1-9]\\d{0,8}|[1-3]\\d{9}|4[0-1]\\d{8}|42[0-8]\\d{7}|429[0-3]\\d{6}|4294[0-8]\\d{5}|42949[0-5]\\d{4}|429496[0-6]\\d{3}|4294967[0-1]\\d{2}|42949672[0-8]\\d|429496729[0-5]))?$",
            "patternDescription": "Network address and optional parameter ['hidden' or 'ospf_tag'], separated by a colon. Ospf_tag=0-4294967295",
            "patternExample": ["192.168.1.0/24", "192.168.1.0/24:hidden", "192.168.1.0/24:55"]
          }
        }
      }
    },

    "actions": {
      "ranges": {
        "exec": "./subscript/routing/ospf/area.uc",
        "args": ["ranges"],
        "wait": true,
        "title": "Ranges",
        "description": "State of area IP ranges, including NSSA external ones, as a table"
      }
    }
	},

  "delete": {
    "exec": "./subscript/routing/ospf/area.uc",
    "args": ["delete"],
    "reload": true
	},

	"add": {
		"exec": "./subscript/routing/ospf/area.uc",
    "args": ["add"],
    "merge": true,
    "description": "add new entry (params: <name> <area-id>)",
    "schema": {
    	"required": ["name", "id"],
      "properties": {
       "name": {"$ref": "/defaults#/definitions/name"},
       "id": {"$ref": "#/definitions/id"},
       "instance": {"cue": ["/routing/ospf/instance"]}
      }
    }
  },
  
  "apply": {
    "exec": "./subscript/routing/ospf/area.uc",
    "args": ["apply"]
  },
  
  "clean": {
    "exec": "./subscript/routing/ospf/area.uc",
    "args": ["clean"],
    "confirm": true,
    "reload": true
  },

	"set": {
		"exec": "./subscript/routing/ospf/area.uc",
		"args": ["set"]
	},

	"acquire": {
		"exec": "./subscript/routing/ospf/area.uc",
		"args": ["get"]
	},

	"status": {
		"exec": "./subscript/routing/ospf/area.uc",
		"args": ["status"]
	}

}