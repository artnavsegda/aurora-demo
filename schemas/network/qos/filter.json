{
    "$schema": "http://json-schema.org/schema#",
    "documentation": ["local"],
    "title": "Filter",
    "description": "IP traffic classification for Quality of Service (QoS) prioritization",
    "type": "object",
    "namesake": "_index",
    "definitions": {
        "interface": {
            "type": "string",
            "cue": ["/ip/interface", "/mobile/modem"]
        }
    },
    "patternProperties": {
        ".*": {
            "type": "object",
            "title": "filter entity",
            "properties": {
                "interface": {
                    "$ref": "#/definitions/interface",
                    "readOnly": true,
                    "description": "Interface name to which queue is applied"
                },

                "prio": {
                    "type": "number",
                    "description": "Classifier priority (lower values match first)"
                },

                "handle": {
                    "type": "number",
                    "description": "Connection tracking (conntrack) mark matching",
                    "minimum": 0,
                    "maximum": 4294967295
                },

                "queue": {
                    "type": "string",
                    "description": "Route classified traffic to this class",
                    "cue": [
                        "/network/qos/queue[type:class]",
                        "/network/qos/queue[queue:prio]"
                    ]
                },

                "_priorityable": {
                    "type": "boolean",
                    "description": "hidden option, notice that the queue=prio",
                    "hidden": true,
                    "noExport": true
                },

                "band": {
                    "type": "number",
                    "description": "Route classified traffic to this queue band of type 'prio'",
                    "enum": [1,2,3],
                    "hidden": true,
                    "modificator": [
                        {"if": [{"_priorityable": true}], "then": {"hidden": false}}
                    ]
                },

                "u32-ip-filter": {
                    "type": "array",
                    "title": "U32 IP filter",
                    "description": "IP packet classification by matching bit values",
                    "uniqueItems": true,
                    "items": {
                        "type": "pair",
                        "enum": ["dst", "dport", "src", "sport", "protocol", "dscp", "icmp_code", "icmp_type"],
                        "strictEnum": true,
                        "pattern": "(^[a-zA-Z_]+=(?:[01]?\\d\\d?|2[0-4]\\d|25[0-5])(?:\\.(?:[01]?\\d\\d?|2[0-4]\\d|25[0-5])){3}(?:\\/(([0-2]?\\d|3[0-2])))$)|(^((?!dscp).)[a-zA-Z_]+=((!?(?![5-9]\\d{9})(?!4[3-9]\\d{8})(?!429[5-9]\\d{6})(?!42949[7-9]\\d{4})(?!429496[8-9]\\d{3})(?!4294967[3-9]\\d{2})(?!429496729[6-9])[\\d]{0,10}))|(^dscp=((6[0-3])|([1-5]\\d{1})|(\\d{1})))$)",
                        "patternDescription": "IPADDR/PREFIX or NUMBER",
                        "patternExample": ["src=192.168.1.1/24", "sport=22"]
                    }
                },

                "u32": {
                    "type": "string",
                    "description": "IP packet classification by 32-bit value and mask with arbitrary offset",
                    "pattern": "^(0x(?:[0-9a-f]{1,8}))\\/(0x(?:[0-9a-f]{1,8}))(?: at \\d+)?$",
                    "patternDescription": "Bitmask value in 0x00/0xff format and offset in bytes (optional)",
                    "patternExample": ["0x00/0xff", "0x00/0xff at 0"]
                }
            }
        }
    },
    "delete": {
        "exec": "subscript/network/qos/filter.uc",
        "args": ["delete"],
        "reload": true
    },

    "apply": {
        "exec": "subscript/network/qos/filter.uc",
        "description": "apply QoS settings",
        "args": ["apply"]
    },

    "add": {
        "exec": "subscript/network/qos/filter.uc",
        "args": ["add"],
        "merge": true,
        "schema": {
            "required": ["interface"],
            "properties": {
                "interface": {
                    "$ref": "#/definitions/interface",
                    "description": "Interface name to which queue is applied"
                }
            }
        }
    },

    "clean": {
        "exec": "subscript/network/qos/filter.uc",
        "args": ["clean"],
        "reload": true,
        "confirm": true
    },

    "set": {
        "exec": "subscript/network/qos/filter.uc",
        "args": ["set"]
    },

    "acquire": {
        "exec": "subscript/network/qos/filter.uc",
        "args": ["get"]
    }
}
