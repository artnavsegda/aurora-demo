{
    "$schema": "http://json-schema.org/schema#",
    "documentation": ["local"],
    "title": "Queue",
    "description": "Traffic queue management",
    "type": "object",
    "namesake": "name",
    "definitions": {
        "parent": {
            "type": "string",
            "description": "Parent element, interface, device or queue",
            "cue": ["/network/qos/queue", "/ip/interface", "/mobile/modem"]
        },
        "queue": {
            "type": "string",
            "description": "Queue type for traffic management",
            "enum": ["htb", "fair", "red", "prio", "fifo"],
            "strictEnum": true
        },
        "bandwidth": {
            "type": "string",
            "description": "Bandwidth allocation limit for traffic shaping",
            "pattern": "^(\\d+[mk]?)?$",
            "patternDescription": "Bandwidth per second (decimal prefixes allowed)",
            "patternExample": ["4096", "512k", "10m"]
        },
        "band": {
            "type": "number",
            "strictEnum": true,
            "description": "Class priority (lower values match first)"
        }
    },
    "showParams": ["parent", "queue", "type"],
    "patternProperties": {
        ".*": {
            "type": "object",
            "title": "queue entity",
            "required": ["parent", "queue", "htb-rate", "red-limit", "red-avpkt"],
            "properties": {
                "parent": {
                    "$ref": "#/definitions/parent",
                    "hidden": true,
                    "readOnly": true
                },
                "root": {
                    "type": "boolean",
                    "description": "Root element attached to interface",
                    "readOnly": true,
                    "hidden": true
                },
                "major": {
                    "type": "string",
                    "hidden": true,
                    "readOnly": true
                },
                "minor": {
                    "type": "string",
                    "hidden": true,
                    "readOnly": true
                },
                "type": {
                    "type": "string",
                    "hidden": true,
                    "readOnly": true
                },
                "queue": {
                    "$ref": "#/definitions/queue",
                    "readOnly": true,
                    "hidden": true
                },
                "_noband": {
                    "type": "boolean",
                    "hidden": true,
                    "noExport": true
                },
                "band": {
                    "$ref": "#/definitions/band",
                    "enum": [1,2,3],
                    "description": "Attach a queue to this band of type prio",
                    "modificator": [
                        {"if": [{"queue": "htb"}, {"type": "class"}], "then": {"hidden": true}},
                        {"if": [{"root": true}], "then": {"hidden": true}},
                        {"if": [{"_noband": true}], "then": {"hidden": true}}
                    ]
                },
                "htb-rate": {
                    "title": "HTB rate",
                    "$ref": "#/definitions/bandwidth",
                    "description": "Maximum guaranteed bandwidth for this class and all child classes",
                    "hidden": true,
                    "modificator": [
                        {"if": [{"queue": "htb"}], "then": {"hidden": false}}
                    ]
                },
                "htb-ceil": {
                    "title": "HTB ceil",
                    "$ref": "#/definitions/bandwidth",
                    "description": "Bandwidth available with borrowing",
                    "hidden": true,
                    "modificator": [
                        {"if": [{"queue": "htb"}], "then": {"hidden": false}}
                    ]
                },
                "htb-burst": {
                    "title": "HTB burst",
                    "$ref": "#/definitions/bandwidth",
                    "description": "Amount of bytes sent at 'htb-ceil' speed before switching to the next class",
                    "hidden": true,
                    "modificator": [
                        {"if": [{"queue": "htb"}], "then": {"hidden": false}}
                    ]
                },
                "htb-prio": {
                    "title": "HTB prio",
                    "$ref": "#/definitions/band",
                    "hidden": true,
                    "enum": [1,2,3,4,5,6,7,8],
                    "modificator": [
                        {"if": [{"queue": "htb"}, {"type":"class"}], "then": {"hidden": false}}
                    ]
                },
                "htb-default": {
                    "type": "string",
                    "title": "HTB default",
                    "description": "Default traffic class for unclassified packets",
                    "hidden": true,
                    "modificator": [
                        {"if": [{"queue": "htb"}, {"type": "qdisc"}], "then": {"hidden": false}}
                    ],
                    "cue": ["/network/qos/queue[type:class]"]
                },
                "htb-r2q": {
                    "title": "HTB r2q",
                    "description": "Frequency of DRR quantums calculation for HTB scheduler",
                    "type": "number",
                    "minimum": 1,
                    "default": "10",
                    "hidden": true,
                    "modificator": [
                        {"if": [{"queue": "htb"}, {"type":"qdisc"}], "then": {"hidden": false}}
                    ]
                },
                "htb-quantum": {
                    "title": "HTB quantum",
                    "type": "number",
                    "minimum": 1,
                    "description": "Amount of bytes a stream can transfer within a class",
                    "hidden": true,
                    "modificator": [
                        {"if": [{"queue": "htb"}], "then": {"hidden": false}}
                    ]
                },
                "red-min": {
                    "type": "number",
                    "title": "RED min",
                    "description": "Average queue size at which marking becomes a possibile (bytes)",
                    "minimum": 1,
                    "hidden": true,
                    "modificator": [
                        {"if": [{"queue": "red"}], "then": {"hidden": false}}
                    ]
                },
                "red-max": {
                    "type": "number",
                    "title": "RED max",
                    "description": "Average queue size (bytes) at which marking probability is maximum",
                    "minimum": 1,
                    "hidden": true,
                    "modificator": [
                        {"if": [{"queue": "red"}], "then": {"hidden": false}}
                    ]
                },
                "red-probability": {
                    "type": "string",
                    "title": "RED probability",
                    "description": "Maximum probability of marking",
                    "pattern": "^((?:0(\\.\\d{1,2}))|([01]))$",
                    "patternDescription": "Decimal fraction between 0 and 1",
                    "patternExample": ["0", "0.01", "1"],
                    "default": "0.02",
                    "hidden": true,
                    "modificator": [
                        {"if": [{"queue": "red"}], "then": {"hidden": false}}
                    ]
                },
                "red-limit": {
                    "type": "number",
                    "title": "RED limit",
                    "description": "Queue buffer size limit (bytes) - subsequent packets will be dropped",
                    "minimum": 1,
                    "hidden": true,
                    "modificator": [
                        {"if": [{"queue": "red"}], "then": {"hidden": false}}
                    ]
                },
                "red-burst": {
                    "type": "number",
                    "title": "RED burst",
                    "description": "The interval (bytes) between adjusting the average queue size to the actual one",
                    "minimum": 1,
                    "hidden": true,
                    "modificator": [
                        {"if": [{"queue": "red"}], "then": {"hidden": false}}
                    ]
                },
                "red-avpkt": {
                    "type": "number",
                    "title": "RED avpkt",
                    "description": "Packet size (bytes) used to calculate average queue size",
                    "minimum": 1,
                    "hidden": true,
                    "modificator": [
                        {"if": [{"queue": "red"}], "then": {"hidden": false}}
                    ]
                },
                "red-bandwidth": {
                    "$ref": "#/definitions/bandwidth",
                    "title": "RED bandwidth",
                    "description": "Interface speed for calculations (traffic is not limited)",
                    "default": "10m",
                    "minimum": 1,
                    "hidden": true,
                    "modificator": [
                        {"if": [{"queue": "red"}], "then": {"hidden": false}}
                    ]
                },
                "red-ecn": {
                    "type": "boolean",
                    "title": "RED ECN",
                    "description": "Explicit Congestion Notification, notifies remote hosts when their bandwidth is exceeded",
                    "hidden": true,
                    "modificator": [
                        {"if": [{"queue": "red"}], "then": {"hidden": false}}
                    ]
                },
                "red-harddrop": {
                    "type": "boolean",
                    "title": "RED harddrop",
                    "description": "Force packet drops if average queue size exceeds red-max threshold",
                    "hidden": true,
                    "modificator": [
                        {"if": [{"queue": "red"}], "then": {"hidden": false}}
                    ]
                },
                "red-adaptive": {
                    "type": "boolean",
                    "title": "RED adaptive",
                    "description": "Dynamically change 'red-probability' to match the average queue size",
                    "hidden": true,
                    "modificator": [
                        {"if": [{"queue": "red"}], "then": {"hidden": false}}
                    ]
                }
            }
        }
    },
    "delete": {
        "exec": "handler",
        "args": ["delete", "network/qos/queue"],
        "reload": true
    },

    "apply": {
        "exec": "handler",
        "args": ["apply", "network/qos/queue"]
    },

    "add": {
        "exec": "handler",
        "args": ["add", "network/qos/queue"],
        "merge": true,
        "schema": {
            "required": ["parent", "queue"],
            "properties": {
                "parent": {
                    "$ref": "#/definitions/parent"
                },
                "queue": {
                    "$ref": "#/definitions/queue"
                }
            }
        }
    },

    "clean": {
        "exec": "subscript/network/qos/queue.uc",
        "args": ["clean"],
        "reload": true,
        "confirm": true
    },

    "status": {
        "exec": "subscript/network/qos/queue.uc",
        "args": ["status"]
    },

    "set": {
        "exec": "subscript/network/qos/queue.uc",
        "args": ["set"]
    },

    "acquire": {
        "exec": "subscript/network/qos/queue.uc",
        "args": ["get"]
    }
}
