{
  "$schema": "http://json-schema.org/schema#",
  "documentation": [
    "local",
    "global"
  ],
  "title": "Events",
  "description": "Automation scenario",
  "type": "object",
  "namesake": "_index",
  "showParams": [
    "trigger",
    "target",
    "value",
    "owner"
  ],
  "patternProperties": {
    ".*": {
      "type": "object",
      "title": "Event entity",
      "required": [
        "trigger",
        "target",
        "value"
      ],
      "properties": {
        "disabled": {
          "$ref": "/defaults#/definitions/disabled"
        },
        "_index": {
          "type": "string",
          "hidden": true
        },
        "owner": {
          "type": "string",
          "hidden": true,
          "readOnly": true,
          "noExport": true
        },
        "description": {
          "type": "string",
          "description": "Script description for configuration notes"
        },
        "trigger": {
          "type": "string",
          "description": "Event source subsystem",
          "readOnly": true
        },
        "target": {
          "type": "string",
          "description": "Source object of the event",
          "modificator": [
            {
              "if": [
                {
                  "trigger": "scheduler"
                }
              ],
              "then": {
                "description": "Execution interval",
                "pattern": "^(((0[0-9]|1[0-9]|2[0-3])(:([0-5][0-9]))?)|(\\~(([0-9])|([0-9][0-9]))[hm]))$",
                "patternDescription": "HH:MM, ~HH, ~MM",
                "patternExample": [
                  "10:10",
                  "~12h",
                  "~30m"
                ]
              }
            },
            {
              "if": [
                {
                  "trigger": "gpio"
                }
              ],
              "then": {
                "cue": [
                  "/peripheral/gpio[.type:gpio]"
                ]
              }
            },
            {
              "if": [
                {
                  "trigger": "gpi"
                }
              ],
              "then": {
                "cue": [
                  "/peripheral/gpio[.type:gpi]"
                ]
              }
            },
            {
              "if": [
                {
                  "trigger": "extra-gpi"
                }
              ],
              "then": {
                "cue": [
                  "/peripheral/gpio[.type:gpi]"
                ]
              }
            },
            {
              "if": [
                {
                  "trigger": "sms"
                }
              ],
              "then": {
                "description": "Message sender",
                "pattern": "^(([A-Za-z0-9.-_ ]{3,11})|(\\+([0-9]{1,3})([0-9]{4,15})))$",
                "patternDescription": "Phone number or sender ID",
                "patternExample": [
                  "+991234567890",
                  "Bank"
                ]
              }
            },
            {
              "if": [
                {
                  "trigger": "pinger"
                }
              ],
              "then": {
                "cue": [
                  "/service/pinger"
                ],
                "description": "Pinger service"
              }
            },
            {
              "if": [
                {
                  "trigger": "defaultroute"
                }
              ],
              "then": {
                "hidden": true
              }
            },
            {
              "if": [
                {
                  "trigger": "interface"
                }
              ],
              "then": {
                "cue": [
                  "/ip/interface",
                  "/tunnel[proto:!]"
                ],
                "description": "IP interface"
              }
            },
            {
              "if": [
                {
                  "trigger": "ipsec"
                }
              ],
              "then": {
                "cue": [
                  "/tunnel/ipsec/association"
                ],
                "description": "IPsec Security Association (SA) configuration"
              }
            }
          ]
        },
        "value": {
          "type": "string",
          "description": "The value of the object for comparison of the event",
          "hidden": true,
          "strictEnum": false,
          "modificator": [
            {
              "if": [
                {
                  "trigger": "gpio"
                }
              ],
              "then": {
                "enum": [
                  "0",
                  "1",
                  "any"
                ],
                "strictEnum": true,
                "hidden": false
              }
            },
            {
              "if": [
                {
                  "trigger": "gpi"
                }
              ],
              "then": {
                "enum": [
                  "0",
                  "1",
                  "any"
                ],
                "strictEnum": true,
                "hidden": false
              }
            },
            {
              "if": [
                {
                  "trigger": "sms"
                }
              ],
              "then": {
                "description": "Incoming message text",
                "hidden": false
              }
            },
            {
              "if": [
                {
                  "trigger": "pinger"
                }
              ],
              "then": {
                "enum": [
                  "success",
                  "fail",
                  "any"
                ],
                "strictEnum": true,
                "hidden": false,
                "description": "Interface status change"
              }
            },
            {
              "if": [
                {
                  "trigger": "defaultroute"
                }
              ],
              "then": {
                "enum": [
                  "change",
                  "dead",
                  "any"
                ],
                "strictEnum": true,
                "hidden": false,
                "description": "Default route change"
              }
            },
            {
              "if": [
                {
                  "trigger": "interface"
                }
              ],
              "then": {
                "enum": [
                  "up",
                  "down",
                  "any"
                ],
                "strictEnum": true,
                "hidden": false,
                "description": "Interface status change"
              }
            },
            {
              "if": [
                {
                  "trigger": "ipsec"
                }
              ],
              "then": {
                "enum": [
                  "up",
                  "down",
                  "any"
                ],
                "strictEnum": true,
                "hidden": false,
                "description": "Connection status change"
              }
            }
          ]
        },
        "action": {
          "type": "string",
          "description": "CLI command executed if the incoming event matches the configuration"
        }
      }
    }
  },
  "delete": {
    "exec": "subscript/service/event.uc",
    "args": [
      "delete"
    ],
    "reload": true
  },
  "add": {
    "exec": "subscript/service/event.uc",
    "args": [
      "add"
    ],
    "merge": true,
    "schema": {
      "required": [
        "trigger"
      ],
      "properties": {
        "trigger": {
          "type": "string",
          "cue": [
            "/defaults/event_triggers",
            "+scheduler",
            "+pinger",
            "+interface",
            "+ipsec",
            "+defaultroute"
          ],
          "strictEnum": true
        }
      }
    }
  },
  "clean": {
    "exec": "subscript/service/event.uc",
    "args": [
      "clean"
    ],
    "confirm": true,
    "reload": true
  },
  "set": {
    "exec": "subscript/service/event.uc",
    "args": [
      "set"
    ]
  },
  "apply": {
    "exec": "subscript/service/event.uc",
    "args": [
      "apply"
    ]
  },
  "reorder": {
    "exec": "subscript/service/event.uc",
    "description": "Change the position of an object",
    "args": [
      "reorder"
    ]
  },
  "acquire": {
    "exec": "subscript/service/event.uc",
    "args": [
      "get"
    ]
  },
  "status": {
    "exec": "subscript/service/event.uc",
    "args": [
      "status"
    ]
  }
}