{
  "$schema": "http://json-schema.org/schema#",
  "documentation": [
    "local",
    "global"
  ],
  "description": "DHCP server for IP address management",
  "type": "object",
  "definitions": {
    "interface": {
      "type": "string",
      "description": "The interface associated with this DHCP address pool",
      "cue": [
        "/ip/interface",
        "/tunnel/eoip",
        "/tunnel/l2tp",
        "/tunnel/openvpn",
        "/defaults/server"
      ]
    }
  },
  "namesake": "interface",
  "showParams": [
    "mode"
  ],
  "patternProperties": {
    ".*": {
      "type": "object",
      "required": [
        "interface"
      ],
      "properties": {
        "interface": {
          "type": "string",
          "noExport": true,
          "hidden": true
        },
        "disabled": {
          "$ref": "/defaults#/definitions/disabled"
        },
        "mode": {
          "type": "string",
          "description": "DHCP server mode to configure request handling",
          "enum": [
            "server",
            "relay"
          ]
        },
        "server": {
          "$ref": "/defaults#/definitions/host-port",
          "description": "DHCP relay server to forward client requests",
          "hidden": true,
          "modificator": [
            {
              "if": [
                {
                  "mode": "relay"
                }
              ],
              "then": {
                "hidden": false
              }
            }
          ]
        },
        "relay-mode": {
          "type": "string",
          "title": "Relay Mode",
          "description": "DHCP Option 82 handling for relay agent information",
          "enum": [
            "append",
            "replace",
            "forward",
            "discard"
          ],
          "hidden": true,
          "modificator": [
            {
              "if": [
                {
                  "mode": "relay"
                },
                {
                  "suboption": true
                }
              ],
              "then": {
                "hidden": false,
                "readOnly": true
              }
            },
            {
              "if": [
                {
                  "mode": "relay"
                },
                {
                  "suboption": false
                }
              ],
              "then": {
                "hidden": false
              }
            }
          ]
        },
        "circuit-id": {
          "type": "string",
          "title": "Circuit ID",
          "description": "Option 82 Circuit ID (macaddr, ipaddr, etc)",
          "hidden": true,
          "noExport": true
        },
        "remote-id": {
          "type": "string",
          "title": "Remote ID",
          "description": "Option 82 Remote ID",
          "hidden": true,
          "modificator": [
            {
              "if": [
                {
                  "mode": "relay"
                }
              ],
              "then": {
                "hidden": false
              }
            }
          ]
        },
        "hops": {
          "type": "integer",
          "title": "Maximum hops",
          "description": "DHCP hop limit to prevent relay loops",
          "maximum": 255,
          "default": 3,
          "hidden": true,
          "modificator": [
            {
              "if": [
                {
                  "mode": "relay"
                }
              ],
              "then": {
                "hidden": false
              }
            }
          ]
        },
        "suboption": {
          "type": "boolean",
          "title": "Enable RFC 3527",
          "description": "Send link selection suboption for directly connected clients",
          "hidden": true,
          "modificator": [
            {
              "if": [
                {
                  "mode": "relay"
                }
              ],
              "then": {
                "hidden": false
              }
            }
          ]
        },
        "debug": {
          "$ref": "/defaults#/definitions/debug",
          "hidden": true,
          "modificator": [
            {
              "if": [
                {
                  "mode": "relay"
                }
              ],
              "then": {
                "hidden": false
              }
            }
          ]
        },
        "pool": {
          "type": "array",
          "title": "IP pool",
          "description": "IP address pool range for DHCP assignments",
          "items": {
            "type": "string",
            "pattern": "^(([01]?\\d\\d?|2[0-4]\\d|25[0-5])(\\.([01]?\\d\\d?|2[0-4]\\d|25[0-5])){3})(-(([01]?\\d\\d?|2[0-4]\\d|25[0-5])(\\.([01]?\\d\\d?|2[0-4]\\d|25[0-5])){3}))?$",
            "patternDescription": "IP address or range specified with a '-' symbol",
            "patternExample": [
              "192.168.1.100",
              "192.168.1.100-192.168.1.100"
            ]
          },
          "hidden": true,
          "modificator": [
            {
              "if": [
                {
                  "mode": "server"
                }
              ],
              "then": {
                "hidden": false
              }
            }
          ]
        },
        "router": {
          "$ref": "/defaults#/definitions/ipaddr-strict",
          "title": "router",
          "description": "Default gateway IP address (DHCP Option 3)",
          "hidden": true,
          "modificator": [
            {
              "if": [
                {
                  "mode": "server"
                }
              ],
              "then": {
                "hidden": false
              }
            }
          ]
        },
        "dns-server": {
          "type": "array",
          "title": "DNS server",
          "description": "DNS server IP address (DHCP Option 6)",
          "items": {
            "$ref": "/defaults#/definitions/ipaddr-strict"
          },
          "hidden": true,
          "modificator": [
            {
              "if": [
                {
                  "mode": "server"
                }
              ],
              "then": {
                "hidden": false
              }
            }
          ]
        },
        "ntp-server": {
          "type": "array",
          "title": "NTP server",
          "description": "NTP server IP address (DHCP Option 42)",
          "items": {
            "$ref": "/defaults#/definitions/ipaddr-strict"
          },
          "hidden": true,
          "modificator": [
            {
              "if": [
                {
                  "mode": "server"
                }
              ],
              "then": {
                "hidden": false
              }
            }
          ]
        },
        "leasetime": {
          "type": "string",
          "description": "IP lease duration to define assignment timeframe",
          "enum": [
            "30m",
            "1h",
            "4h",
            "12h",
            "24h",
            "7d"
          ],
          "hidden": true,
          "modificator": [
            {
              "if": [
                {
                  "mode": "server"
                }
              ],
              "then": {
                "hidden": false
              }
            }
          ]
        },
        "flags": {
          "type": "array",
          "description": "DHCP server parameter for advanced configuration",
          "items": {
            "type": "string",
            "enum": [
              "authoritative",
              "no-override",
              "sequential-ip",
              "rapid-commit"
            ]
          },
          "hidden": true,
          "modificator": [
            {
              "if": [
                {
                  "mode": "server"
                }
              ],
              "then": {
                "hidden": false
              }
            }
          ]
        },
        "option": {
          "type": "array",
          "title": "DHCP Options",
          "description": "Additional DHCP Options",
          "strictEnum": true,
          "uniqueItems": false,
          "items": {
            "type": "pair",
            "pattern": "(^bootfile-name\\=((0x([0-9A-F]+))|((?!0x)(\\S+)))$)|(^tftp-server\\=((0x([0-9A-F]+))|((?!0x)(\\S+)))$)|(^classless-static-route\\=([01]?\\d\\d?|2[0-4]\\d|25[0-5])(\\.([01]?\\d\\d?|2[0-4]\\d|25[0-5])){3}(\\/(([0-2]?\\d|3[0-2])))@([01]?\\d\\d?|2[0-4]\\d|25[0-5])(\\.([01]?\\d\\d?|2[0-4]\\d|25[0-5])){3}$)",
            "patternDescription": "Key and value separated by the '=' symbol",
            "patternExample": [
              "tftp-server=192.168.1.100",
              "bootfile=image.bin",
              "classless-static-route=192.168.1.0/24@1.2.3.4"
            ],
            "enum": [
              "tftp-server",
              "bootfile-name",
              "classless-static-route"
            ]
          },
          "hidden": true,
          "modificator": [
            {
              "if": [
                {
                  "mode": "server"
                }
              ],
              "then": {
                "hidden": false
              }
            }
          ]
        }
      }
    }
  },
  "delete": {
    "exec": "subscript/service/dhcp/server.uc",
    "args": [
      "delete"
    ],
    "reload": true
  },
  "add": {
    "exec": "subscript/service/dhcp/server.uc",
    "args": [
      "add"
    ],
    "merge": true,
    "schema": {
      "required": [
        "interface"
      ],
      "properties": {
        "interface": {
          "$ref": "#/definitions/interface",
          "description": "DHCP interface to serve client requests",
          "title": "Interface"
        }
      }
    }
  },
  "apply": {
    "exec": "subscript/service/dhcp/server.uc",
    "args": [
      "apply"
    ]
  },
  "clean": {
    "exec": "subscript/service/dhcp/server.uc",
    "args": [
      "clean"
    ],
    "reload": true,
    "confirm": true
  },
  "status": {
    "exec": "subscript/service/dhcp/server.uc",
    "args": [
      "status"
    ]
  },
  "set": {
    "exec": "subscript/service/dhcp/server.uc",
    "args": [
      "set"
    ]
  },
  "acquire": {
    "exec": "subscript/service/dhcp/server.uc",
    "args": [
      "get"
    ]
  }
}