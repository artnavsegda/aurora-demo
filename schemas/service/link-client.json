{
    "$schema": "http://json-schema.org/schema#",
    "documentation": ["local"],
    "title": "Link Client",
    "description": "Client application for the remote control service 'Link'",
    "type": "object",
    "required": ["server"],
    "properties": {
        "disabled": {
            "$ref": "/defaults#/definitions/disabled"
        },

        "server": {
            "$ref": "/defaults#/definitions/host-port",
            "description": "Address of management server Link",
            "title": "Server"
        },
        "recv-timeout": {
            "hidden": true,
            "title": "ACK timeout",
            "type": "number",
            "default": 20,
            "description": "Management server response timeout (sec)"
        },
        "resend-attempts": {
            "hidden": true,
            "title": "Resend attempts",
            "type": "number",
            "default": 3,
            "description": "Maximum message retry attempts on failure"
        },
        "recv-timeout-error": {
            "hidden": true,
            "title": "Timeout error",
            "type": "number",
            "default": 20,
            "description": "Error message reporting delay (sec)"
        },
        "update-interval": {
            "title": "Force update",
            "type": "number",
            "default": 600,
            "description": "Full status report interval (sec)"
        },
        "keep-alive-interval": {
            "title": "Keepalive",
            "type": "number",
            "default": 60,
            "description": "Keepalive heartbeat interval (sec)"
        },
        "queue-size": {
            "hidden": true,
            "title": "Queue",
            "type": "number",
            "default": 20,
            "description": "Message queue size limit"
        },
        "denied-timeout": {
            "hidden": true,
            "title": "Denied timeout",
            "type": "number",
            "default": 3600,
            "description": "Reconnection delay after failure (sec)"

        },
        "key": {
            "title": "Encryption Key",
            "type": "string",
            "description": "SHA-256 data encryption key"
        }

    },

    "status": {
        "exec": "subscript/service/rms.uc",
        "args": ["status"]
    },

    "apply": {
        "exec": "subscript/service/rms.uc",
        "args": ["apply"]
    },

    "set": {
        "exec": "subscript/service/rms.uc",
        "args": ["set"]
    },
    "acquire": {
        "exec": "subscript/service/rms.uc",
        "args": ["get"]
    }
}
