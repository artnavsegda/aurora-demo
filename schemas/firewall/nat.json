{
    "$schema": "http://json-schema.org/schema#",
    "documentation": ["local", "global"],
    "title": "NAT Rules",
    "description": "NAT table for address translation",
    "type": "object",
    "namesake": "_index",
    "showParams": ["chain", "src", "src-addr", "dst", "dst-addr", "protocol", "mark", "action"],
    "patternProperties": {
        ".*": {
            "type": "object",
            "title": "NAT entity",
            "properties": {
                "disabled": {
                    "$ref": "/defaults#/definitions/disabled",
                    "description": "Disable firewall rule"
                },

                "_index": {
                    "type": "string",
                    "hidden": true
                },

                "chain": {
                    "$ref": "#/definitions/chain"
                },

                "src": {
                    "type": "string",
                    "description": "Traffic source (zone or interface)",
                    "title": "source",
                    "modificator": [
                        {"if": [{"chain": "output"}], "then": {"cue": ["/firewall/zone[type:address]"]}},
                        {"if": [{"chain": "postrouting"}], "then": {"cue": ["/firewall/zone[type:address]"]}}
                    ],
                    "cue": [
                        "/network/device",
                        "/network/ethernet",
                        "/wireless/network",
                        "/ip/interface",
                        "/mobile/modem",
                        "/tunnel[proto:!]",
                        "/tunnel/atunnel",
                        "/defaults/server",
                        "/firewall/zone"
                    ]
                },

                "src-addr": {
                    "$ref": "/defaults#/definitions/fw-ipaddr-port",
                    "title": "source address",
                    "description": "Source IP address range or host",
                    "enableInvert": true
                },

                "dst": {
                    "type": "string",
                    "title": "destination",
                    "description": "Traffic destination (interface or zone)",
                    "modificator": [
                        {"if": [{"chain": "prerouting"}], "then": {"cue": ["/firewall/zone[type:address]"]}}
                    ],
                    "cue": [
                        "/network/device", 
                        "/network/ethernet", 
                        "/wireless/network", 
                        "/ip/interface", 
                        "/mobile/modem", 
                        "/tunnel[proto:!]", 
                        "/tunnel/atunnel",
                        "/defaults/server",
                        "/firewall/zone"
                    ]
                },

                "dst-addr": {
                    "$ref": "/defaults#/definitions/fw-ipaddr-port",
                    "title": "destination address",
                    "description": "Destination IP address range or host",
                    "enableInvert": true
                },

                "protocol": {
                    "$ref": "/defaults#/definitions/fw-protocol",
                    "default": "all"
                },

                "icmp-type": {
                    "hidden": true,
                    "$ref": "/defaults#/definitions/fw-icmp-type",
                    "title": "ICMP Type",
                    "modificator": [
                        {"if": [{"protocol": "icmp"}], "then": {"hidden": false}}
                    ],
                    "default": "any"
                },

                "mark": {
                    "$ref": "/defaults#/definitions/fw-mark",
                    "title": "Firewall mark",
                    "description": "Packet mark matching for firewall rule processing",
                    "enableInvert": true
                },

                "action": {
                    "type": "string",
                    "description": "Rule action",
                    "modificator": [
                        {"if": [{"chain": "output"}], "then": {"$ref": "#/definitions/action_dnat"}},
                        {"if": [{"chain": "prerouting"}], "then": {"$ref": "#/definitions/action_dnat"}},
                        {"if": [{"chain": "postrouting"}], "then": {"$ref": "#/definitions/action_snat"}}
                    ]
                },

                "nat-addr": {
                    "hidden": true,
                    "$ref": "/defaults#/definitions/fw-ipaddr-port",
                    "title": "NAT address",
                    "description": "NAT translation for address masquerading",
                    "modificator": [
                        {"if": [{"chain": "output"}, {"action": "dnat"}], "then": {"hidden": false}},
                        {"if": [{"chain": "prerouting"}, {"action": "dnat"}], "then": {"hidden": false}},
                        {"if": [{"chain": "postrouting"}, {"action": "snat"}], "then": {"hidden": false}}
                    ]
                },

                "redirect-port": {
                    "hidden": true,
                    "$ref": "/defaults#/definitions/port",
                    "title": "Redirect Port",
                    "description": "Port forwarding to redirect traffic",
                    "modificator": [
                        {"if": [{"chain": "output"}, {"action": "redirect"}], "then": {"hidden": false}},
                        {"if": [{"chain": "prerouting"}, {"action": "redirect"}], "then": {"hidden": false}}
                    ]
                },

                "policy": {
                    "type": "array",
                    "title": "IPSec Policy",
                    "description": "IPsec policy matching criteria",
                    "uniqueItems": true,
                    "items": {
                      "type": "pair",
                      "enum": ["dir", "pol", "strict", "reqid", "spi", "proto", "mode", "tunnel-src", "tunnel-dst"]
                    }
                },

                "extra": {
                    "type": "string",
                    "title": "Extra params",
                    "description": "Custom iptables parameters",
                    "pattern": "^([a-zA-Z0-9-_+*:.,!?\/ ])+$",
                    "patternDescription": "Arguments using iptables syntax",
                    "patternExample": ["-m mac --mac-source FE:FF:FF:FF:FF:FF"]
                }
            }
        },

        "actions": {
            "reset-counters": {
                "title": "Reset Counters",
                "description": "Reset traffic counters for this rule",
                "exec": "subscript/firewall/connections.uc",
                "args": ["reset_nat"]
            }
        }
    },

    "delete": {
        "exec": "subscript/firewall/rules.uc",
        "args": ["delete", "nat"],
        "reload": true
    },

    "apply": {
        "exec": "subscript/firewall/rules.uc",
        "reload": true,
        "args": ["apply", "nat"]
    },

    "add": {
        "exec": "subscript/firewall/rules.uc",
        "args": ["add", "nat"],
        "merge": true,
        "schema": {
            "required": ["chain"],
            "properties": {
                "chain": {"$ref": "#/definitions/chain"}
            }
        }
    },

    "clean": {
        "exec": "subscript/firewall/rules.uc",
        "args": ["clean", "nat"],
        "confirm": true,
        "reload": true
    },

    "status": {
        "exec": "subscript/firewall/rules.uc",
        "args": ["status", "nat"],
        "isTable": true
    },

    "set": {
        "exec": "subscript/firewall/rules.uc",
        "args": ["set", "nat"]
    },

    "reorder": {
        "exec": "subscript/firewall/rules.uc",
        "description": "Change the position of an object",
        "args": ["reorder", "nat"]
    },

    "acquire": {
        "exec": "subscript/firewall/rules.uc",
        "args": ["get", "nat"]
    },

    "definitions": {
        "chain": {
            "type": "string",
            "description": "Firewall chain name for rule grouping",
            "enum": ["prerouting", "postrouting", "output"]
        },

        "action_dnat": {
            "enum": ["accept", "dnat", "redirect"]
        },

        "action_snat": {
            "enum": ["accept", "snat", "masquerade"]
        }

    },

    "actions": {
        "reset-counters": {
            "title": "Reset Counters",
            "description": "Reset all firewall traffic counters",
            "exec": "subscript/firewall/connections.uc",
            "args": ["reset_nat"]
        }
    }

}
