{
  "$schema": "http://json-schema.org/schema#",
  "documentation": [
    "local",
    "global"
  ],
  "title": "EoIP",
  "description": "Ethernet over IP (EoIP) tunnels for network bridging",
  "type": "object",
  "showParams": [
    "local-ip",
    "remote-ip",
    "mtu",
    "encryption"
  ],
  "patternProperties": {
    ".*": {
      "type": "object",
      "title": "EoIP tunnel",
      "description": "Ethernet over IP (EoIP) tunnels for network bridging",
      "required": [
        "remote-ip",
        "psk",
        "tunnel-id"
      ],
      "properties": {
        "l2": {
          "type": "boolean",
          "hidden": true,
          "noExport": true
        },
        "proto": {
          "type": "string",
          "hidden": true,
          "noExport": true
        },
        "disabled": {
          "$ref": "/defaults#/definitions/disabled"
        },
        "local-ip": {
          "$ref": "/defaults#/definitions/interface-ipaddr",
          "title": "Local IP",
          "description": "Local endpoint address or source interface",
          "default": "auto"
        },
        "remote-ip": {
          "$ref": "/defaults#/definitions/host",
          "title": "Remote IP",
          "description": "Remote endpoint (FQDN or IP address)"
        },
        "tunnel-ip": {
          "$ref": "/defaults#/definitions/ipaddr",
          "title": "Tunnel IP",
          "description": "Tunnel interface IP address for virtual networking"
        },
        "tunnel-id": {
          "type": "number",
          "title": "Tunnel ID",
          "description": "Tunnel identifier",
          "minimum": 1,
          "maximum": 65535
        },
        "macaddr": {
          "$ref": "/defaults#/definitions/macaddr",
          "default": "auto"
        },
        "mtu": {
          "$ref": "/defaults#/definitions/mtu",
          "description": "Tunnel interface MTU to define maximum packet size",
          "default": 1462
        },
        "ttl": {
          "$ref": "/defaults#/definitions/ttl",
          "description": "Tunnel interface TTL to control packet lifetime",
          "default": 64
        },
        "dscp": {
          "$ref": "/defaults#/definitions/dscp"
        },
        "keepalive-delay": {
          "type": "number",
          "title": "Keepalive Delay",
          "description": "Keepalive interval in seconds (0 - disabled, MikroTik default is 10)",
          "default": 0,
          "minimum": 0,
          "maximum": 3600
        },
        "keepalive-retries": {
          "type": "number",
          "title": "Keepalive Retries",
          "description": "Missed keepalives before the tunnel goes down (0 - send only)",
          "default": 10,
          "minimum": 0,
          "maximum": 255,
          "hidden": true,
          "modificator": [
            {
              "if": [
                {
                  "keepalive-delay": "!"
                },
                {
                  "keepalive-delay": "!0"
                }
              ],
              "then": {
                "hidden": false
              }
            }
          ]
        },
        "_ipsec-installed": {
          "type": "boolean",
          "description": "hidden option, notice that the ipsec is installed",
          "hidden": true,
          "noExport": true
        },
        "encryption": {
          "type": "string",
          "description": "Tunnel encryption method for secure data transmission",
          "title": "Encryption",
          "enum": [
            "none"
          ],
          "modificator": [
            {
              "if": [
                {
                  "_ipsec-installed": true
                }
              ],
              "then": {
                "enum": [
                  "none",
                  "ipsec"
                ]
              }
            }
          ]
        },
        "psk": {
          "$ref": "/defaults#/definitions/psk",
          "description": "IPsec pre-shared key for tunnel authentication",
          "minLength": 8,
          "hidden": true,
          "modificator": [
            {
              "if": [
                {
                  "encryption": "ipsec"
                }
              ],
              "then": {
                "hidden": false
              }
            }
          ]
        }
      }
    }
  },
  "delete": {
    "exec": "subscript/tunnel/tunnel.uc",
    "args": [
      "delete",
      "eoip"
    ],
    "reload": true
  },
  "add": {
    "exec": "subscript/tunnel/tunnel.uc",
    "args": [
      "add",
      "eoip"
    ],
    "merge": true,
    "schema": {
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "/defaults#/definitions/name",
          "description": "EoIP tunnel interface name for network configuration",
          "maxLength": 15
        }
      }
    }
  },
  "apply": {
    "exec": "subscript/tunnel/tunnel.uc",
    "args": [
      "apply",
      "eoip"
    ]
  },
  "clean": {
    "exec": "subscript/tunnel/tunnel.uc",
    "args": [
      "clean",
      "eoip"
    ],
    "reload": true,
    "confirm": true
  },
  "status": {
    "exec": "subscript/tunnel/tunnel.uc",
    "args": [
      "status",
      "eoip"
    ]
  },
  "set": {
    "exec": "subscript/tunnel/tunnel.uc",
    "args": [
      "set",
      "eoip"
    ]
  },
  "acquire": {
    "exec": "subscript/tunnel/tunnel.uc",
    "args": [
      "get",
      "eoip"
    ]
  }
}