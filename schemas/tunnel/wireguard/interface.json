{
  "$schema": "http://json-schema.org/schema#",
  "documentation": [
    "local",
    "global"
  ],
  "title": "Wireguard",
  "description": "WireGuard network interface",
  "type": "object",
  "showParams": [
    "tunnel-ip",
    "port",
    "mtu",
    "fw-mark"
  ],
  "patternProperties": {
    ".*": {
      "type": "object",
      "title": "WireGuard interface",
      "required": [
        "priv-key",
        "port"
      ],
      "properties": {
        "proto": {
          "type": "string",
          "hidden": true,
          "noExport": true
        },
        "disabled": {
          "$ref": "/defaults#/definitions/disabled"
        },
        "tunnel-ip": {
          "$ref": "/defaults#/definitions/ipaddr",
          "title": "Tunnel IP",
          "description": "Tunnel interface IP address"
        },
        "priv-key": {
          "type": "string",
          "title": "Private key",
          "description": "Private key for authentication and traffic encryption",
          "pattern": "^(?:[A-Za-z0-9+\\/]{4})*(?:[A-Za-z0-9+\\/]{4}|[A-Za-z0-9+\\/]{3}=|[A-Za-z0-9+\\/]{2}={2})$",
          "patternDescription": "Base64-encoded key",
          "patternExample": [
            "ABC123abc456ABC789abc123ABC456abc789Abc123A="
          ]
        },
        "pub-key": {
          "type": "string",
          "title": "Public key",
          "readOnly": true,
          "description": "Public key for authentication and traffic encryption",
          "pattern": "^(?:[A-Za-z0-9+\\/]{4})*(?:[A-Za-z0-9+\\/]{4}|[A-Za-z0-9+\\/]{3}=|[A-Za-z0-9+\\/]{2}={2})$",
          "patternDescription": "Base64-encoded key",
          "patternExample": [
            "ABC123abc456ABC789abc123ABC456abc789Abc123A="
          ]
        },
        "port": {
          "$ref": "/defaults#/definitions/port-strict",
          "description": "Listening port for incoming connections"
        },
        "mtu": {
          "$ref": "/defaults#/definitions/mtu",
          "default": 1420
        },
        "fw-mark": {
          "type": "number",
          "title": "Mark",
          "description": "The mark for packets associated with this interface"
        }
      }
    }
  },
  "status": {
    "exec": "subscript/tunnel/wireguard/interface.uc",
    "args": [
      "status"
    ]
  },
  "apply": {
    "exec": "subscript/tunnel/wireguard/interface.uc",
    "args": [
      "apply"
    ]
  },
  "set": {
    "exec": "subscript/tunnel/wireguard/interface.uc",
    "args": [
      "set"
    ]
  },
  "add": {
    "exec": "subscript/tunnel/wireguard/interface.uc",
    "args": [
      "add"
    ],
    "merge": true,
    "schema": {
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "/defaults#/definitions/name"
        }
      }
    }
  },
  "delete": {
    "exec": "subscript/tunnel/wireguard/interface.uc",
    "args": [
      "delete"
    ],
    "reload": true
  },
  "clean": {
    "exec": "subscript/tunnel/wireguard/interface.uc",
    "args": [
      "clean"
    ],
    "reload": true,
    "confirm": true
  },
  "acquire": {
    "exec": "subscript/tunnel/wireguard/interface.uc",
    "args": [
      "get"
    ]
  }
}