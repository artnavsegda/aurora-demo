{
  "$schema": "http://json-schema.org/schema#",
  "documentation": [
    "local",
    "global"
  ],
  "title": "IPSec tunnel connections",
  "description": "IKE Phase 1 configuration",
  "type": "object",
  "definitions": {},
  "showParams": [
    "local-id",
    "local-ip",
    "remote-ip",
    "remote-id",
    "ike-version"
  ],
  "patternProperties": {
    ".*": {
      "type": "object",
      "title": "Tunnel entity",
      "required": [
        "psk",
        "cert"
      ],
      "properties": {
        "disabled": {
          "$ref": "/defaults#/definitions/disabled"
        },
        "local-ip": {
          "$ref": "/defaults#/definitions/interface-ipaddr",
          "title": "Local IP",
          "description": "Local endpoint address or source interface",
          "default": "auto"
        },
        "remote-ip": {
          "$ref": "/defaults#/definitions/host",
          "title": "Remote IP",
          "description": "Remote endpoint (FQDN or IP address). Not set - wait for incoming connections"
        },
        "ike-version": {
          "type": "string",
          "title": "IKE version",
          "description": "IKE protocol version selection",
          "enum": [
            "ikev2",
            "ikev1"
          ]
        },
        "profile": {
          "type": "string",
          "title": "IKE Profile",
          "description": "IKE/ISAKMP encryption and authentication proposal",
          "cue": [
            "/tunnel/ipsec/profile"
          ]
        },
        "local-id": {
          "type": "string",
          "readOnly": false,
          "title": "Local ID",
          "description": "Local IKE identity for authentication",
          "default": "auto",
          "modificator": [
            {
              "if": [
                {
                  "auth": "pubkey"
                }
              ],
              "then": {
                "readOnly": true
              }
            }
          ]
        },
        "remote-id": {
          "type": "string",
          "title": "Remote ID",
          "description": "Remote IKE identity for verification",
          "default": "auto"
        },
        "auth": {
          "type": "string",
          "title": "Auth method",
          "description": "IKE authentication method",
          "enum": [
            "psk",
            "pubkey"
          ]
        },
        "psk": {
          "$ref": "/defaults#/definitions/psk",
          "title": "Pre-shared key",
          "description": "IKE pre-shared key (PSK)",
          "hidden": true,
          "modificator": [
            {
              "if": [
                {
                  "auth": "psk"
                }
              ],
              "then": {
                "hidden": false
              }
            }
          ]
        },
        "cert": {
          "$ref": "/defaults#/definitions/cert",
          "title": "Certificate",
          "description": "Local certificate (including private key)",
          "hidden": true,
          "modificator": [
            {
              "if": [
                {
                  "auth": "pubkey"
                }
              ],
              "then": {
                "hidden": false
              }
            }
          ]
        },
        "local-virtual-ip": {
          "type": "string",
          "title": "Virtual IP",
          "description": "Virtual IP address for tunnel origination",
          "pattern": "^(?:(%config)|(?:([01]?\\d\\d?|2[0-4]\\d|25[0-5])(\\.([01]?\\d\\d?|2[0-4]\\d|25[0-5])){3})(/([0-2]?\\d|3[0-2]))?|(?:([01]?\\d\\d?|2[0-4]\\d|25[0-5])(\\.([01]?\\d\\d?|2[0-4]\\d|25[0-5])){3})-(?:([01]?\\d\\d?|2[0-4]\\d|25[0-5])(\\.([01]?\\d\\d?|2[0-4]\\d|25[0-5])){3}))$",
          "patternDescription": "IP address (without prefix) or requeste an address from the peer (%config)",
          "patternExample": [
            "192.168.1.1",
            "%config"
          ]
        },
        "remote-virtual-ip": {
          "type": "string",
          "title": "Remote Virtual IP",
          "description": "Assign virtual IP to remote peer",
          "pattern": "^(?:(%config)|(?:([01]?\\d\\d?|2[0-4]\\d|25[0-5])(\\.([01]?\\d\\d?|2[0-4]\\d|25[0-5])){3})(/([0-2]?\\d|3[0-2]))?|(?:([01]?\\d\\d?|2[0-4]\\d|25[0-5])(\\.([01]?\\d\\d?|2[0-4]\\d|25[0-5])){3})-(?:([01]?\\d\\d?|2[0-4]\\d|25[0-5])(\\.([01]?\\d\\d?|2[0-4]\\d|25[0-5])){3}))$",
          "patternDescription": "Single IP address or range specified with a '-' symbol or initiator must propose an address which is then echoed back (%config)",
          "patternExample": [
            "192.168.1.1/24",
            "192.168.1.1-192.168.1.100",
            "%config"
          ]
        }
      }
    }
  },
  "delete": {
    "exec": "subscript/ipsec/connection.uc",
    "args": [
      "delete"
    ],
    "reload": true
  },
  "add": {
    "exec": "subscript/ipsec/connection.uc",
    "args": [
      "add"
    ],
    "merge": true,
    "schema": {
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "/defaults#/definitions/name",
          "description": "IKE connection profile name"
        }
      }
    }
  },
  "apply": {
    "exec": "subscript/ipsec/connection.uc",
    "args": [
      "apply"
    ]
  },
  "clean": {
    "exec": "subscript/ipsec/connection.uc",
    "args": [
      "clean"
    ],
    "confirm": true,
    "reload": true
  },
  "set": {
    "exec": "subscript/ipsec/connection.uc",
    "args": [
      "set"
    ]
  },
  "acquire": {
    "exec": "subscript/ipsec/connection.uc",
    "args": [
      "get"
    ]
  }
}