{
  "$schema": "http://json-schema.org/schema#",
  "documentation": [
    "local",
    "global"
  ],
  "title": "ESP Proposals",
  "description": "ESP security algorithms configuration",
  "type": "object",
  "definitions": {
    "encryption": {
      "type": "array",
      "description": "Data encryption method for secure data transmission",
      "readOnly": false,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "aes128",
          "aes192",
          "aes256",
          "3des"
        ]
      }
    },
    "auth": {
      "type": "array",
      "description": "Authentication algorithm",
      "readOnly": false,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "sha1",
          "sha256",
          "sha384",
          "sha512",
          "md5"
        ]
      }
    },
    "pfs": {
      "type": "array",
      "title": "PFS Group",
      "description": "Perfect Forward Secrecy ensures that DH keys will not be reused",
      "readOnly": false,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "modp768",
          "modp1024",
          "modp1536",
          "modp2048",
          "modp3072",
          "modp4096",
          "modp6144",
          "modp8192",
          "none"
        ]
      }
    }
  },
  "patternProperties": {
    ".*": {
      "type": "object",
      "title": "Proposal entity",
      "properties": {
        "encryption": {
          "$ref": "#/definitions/encryption"
        },
        "auth": {
          "$ref": "#/definitions/auth"
        },
        "pfs": {
          "$ref": "#/definitions/pfs"
        },
        "lifetime": {
          "type": "number",
          "description": "Connection lifetime (sec) from negotiation to expiry",
          "default": 3600
        }
      }
    }
  },
  "delete": {
    "exec": "subscript/ipsec/proposal.uc",
    "args": [
      "delete"
    ],
    "reload": true
  },
  "add": {
    "exec": "subscript/ipsec/proposal.uc",
    "args": [
      "add"
    ],
    "merge": true,
    "schema": {
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "/defaults#/definitions/name"
        }
      }
    }
  },
  "apply": {
    "exec": "subscript/ipsec/proposal.uc",
    "args": [
      "apply"
    ]
  },
  "clean": {
    "exec": "subscript/ipsec/proposal.uc",
    "args": [
      "clean"
    ],
    "confirm": true,
    "reload": true
  },
  "set": {
    "exec": "subscript/ipsec/proposal.uc",
    "args": [
      "set"
    ]
  },
  "acquire": {
    "exec": "subscript/ipsec/proposal.uc",
    "args": [
      "get"
    ]
  }
}