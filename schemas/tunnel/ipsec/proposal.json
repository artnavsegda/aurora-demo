{
  "$schema": "http://json-schema.org/schema#",
  "documentation": ["local", "global"],
  "title": "ESP Proposals",
  "description": "ESP security algorithms configuration",
  "type": "object",
  "definitions": {
    "encryption": {
      "type": "array",
      "description": "Data encryption method for secure data transmission",
      "readOnly": false,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["aes128", "aes192", "aes256", "3des"]
      }
    },
    "auth": {
      "type": "array",
      "description": "Authentication algorithm",
      "readOnly": false,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["sha1", "sha256", "sha384", "sha512", "md5"]
      }
    },
    "pfs": {
      "type": "array",
      "title": "PFS Group",
      "description": "Perfect Forward Secrecy ensures that DH keys will not be reused",
      "readOnly": false,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["modp768", "modp1024", "modp1536", "modp2048", "modp3072", "modp4096", "modp6144", "modp8192", "none"]
      }
    }
  },
  "patternProperties": {
    ".*": {
      "type": "object",
      "title": "Proposal entity",
      "properties": {
        "encryption": {
          "$ref": "#/definitions/encryption"
        },
        "auth": {
          "$ref": "#/definitions/auth"
        },
        "pfs": {
          "$ref": "#/definitions/pfs"
        },
        "lifetime": {
          "type": "number",
          "description": "Connection lifetime (sec) from negotiation to expiry",
          "default": 3600
        }
      }
    }
  },
  
  "delete": {
    "exec": "handler",
    "args": ["delete", "ipsec/proposal"],
    "reload": true
  },

  "add": {
    "exec": "handler",
    "args": ["add", "ipsec/proposal"],
    "merge": true,
    "schema": {
      "required": ["name"],
      "properties": {
        "name": {"$ref": "#/definitions/name"}
      }
    }
  },
  
  "apply": {
    "exec": "handler",
    "args": ["apply", "ipsec/proposal"]
  },

  "clean": {
    "exec": "handler",
    "args": ["clean", "ipsec/proposal"],
    "confirm": true,
    "reload": true
  },

  "_status": {
    "exec": "handler",
    "args": ["status", "ipsec/proposal"]
  },

  "set": {
    "exec": "handler",
    "args": ["set", "ipsec/proposal"]
  },    

  "acquire": {
    "exec": "handler",
    "args": ["get", "ipsec/proposal"]
  }
}
