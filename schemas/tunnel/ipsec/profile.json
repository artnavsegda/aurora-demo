{
  "$schema": "http://json-schema.org/schema#",
  "documentation": [
    "local",
    "global"
  ],
  "title": "IKE Profiles",
  "description": "IKE/ISAKMP SA security proposals",
  "type": "object",
  "definitions": {
    "encryption": {
      "type": "array",
      "description": "Data encryption method for secure data transmission",
      "readOnly": false,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "aes128",
          "aes192",
          "aes256",
          "3des"
        ]
      }
    },
    "hash": {
      "type": "array",
      "description": "Integrity hash algorithm",
      "readOnly": false,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "sha1",
          "sha256",
          "sha384",
          "sha512",
          "md5"
        ]
      }
    },
    "dh": {
      "type": "array",
      "title": "DH Group",
      "description": "Diffie-Hellman key exchange group",
      "readOnly": false,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "modp768",
          "modp1024",
          "modp1536",
          "modp2048",
          "modp3072",
          "modp4096",
          "modp6144",
          "modp8192"
        ]
      }
    }
  },
  "patternProperties": {
    ".*": {
      "type": "object",
      "title": "Profile entity",
      "properties": {
        "encryption": {
          "$ref": "#/definitions/encryption"
        },
        "hash": {
          "$ref": "#/definitions/hash"
        },
        "prf": {
          "$ref": "#/definitions/hash",
          "title": "Pseudo-random Function",
          "description": "Pseudorandom function (PRF) for key derivation"
        },
        "dh": {
          "$ref": "#/definitions/dh"
        },
        "ike-lifetime": {
          "type": "number",
          "title": "IKE Lifetime",
          "description": "IKE/ISAKMP SA rekey interval (seconds)",
          "default": 10800
        },
        "dpd-delay": {
          "type": "integer",
          "title": "DPD Delay",
          "description": "Dead Peer Detection (DPD) packet sending interval",
          "default": 30
        },
        "dpd-timeout": {
          "type": "integer",
          "title": "DPD Timeout",
          "default": 150,
          "description": "Terminate IKEv1 connection after a timeout without a response to the DPD packet"
        },
        "retry-interval": {
          "type": "integer",
          "title": "Retry Interval",
          "hidden": true,
          "minimum": 10,
          "default": 60,
          "description": "Retry setting up a tunnel that is down after this time (sec)"
        },
        "dpd-action": {
          "type": "string",
          "title": "DPD Action",
          "description": "Action to perform when connection is broken due to timeout with no response to the DPD packet",
          "enum": [
            "hold",
            "restart",
            "clear",
            "none"
          ]
        }
      }
    }
  },
  "delete": {
    "exec": "subscript/ipsec/profile.uc",
    "args": [
      "delete"
    ],
    "reload": true
  },
  "add": {
    "exec": "subscript/ipsec/profile.uc",
    "args": [
      "add"
    ],
    "merge": true,
    "schema": {
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "/defaults#/definitions/name"
        }
      }
    }
  },
  "clean": {
    "exec": "subscript/ipsec/profile.uc",
    "args": [
      "clean"
    ],
    "confirm": true,
    "reload": true
  },
  "apply": {
    "exec": "subscript/ipsec/profile.uc",
    "args": [
      "apply"
    ]
  },
  "set": {
    "exec": "subscript/ipsec/profile.uc",
    "args": [
      "set"
    ]
  },
  "acquire": {
    "exec": "subscript/ipsec/profile.uc",
    "args": [
      "get"
    ]
  }
}