{
  "$schema": "http://json-schema.org/schema#",
  "documentation": ["local", "global"],
  "title": "IKE Profiles",
  "description": "IKE/ISAKMP SA security proposals",
  "type": "object",
  "definitions": {
    "encryption": {
      "type": "array",
      "description": "Data encryption method for secure data transmission",
      "readOnly": false,
      "uniqueItems": true,
      "items": {
        "type":"string",
        "enum": ["aes128", "aes192", "aes256", "3des"]
      }
    },
    "hash": {
      "type": "array",
      "description": "Integrity hash algorithm",
      "readOnly": false,
      "uniqueItems": true,
      "items": {
        "type":"string",
        "enum": ["sha1", "sha256", "sha384", "sha512", "md5"]
      }
    },
    "dh": {
      "type": "array",
      "title": "DH Group",
      "description": "Diffie-Hellman key exchange group",
      "readOnly": false,
      "uniqueItems": true,
      "items": {
        "type":"string",
        "enum": ["modp768", "modp1024", "modp1536", "modp2048", "modp3072", "modp4096", "modp6144", "modp8192"]
      }
    }
  },
  "patternProperties": {
    ".*": {
      "type": "object",
      "title": "Profile entity",
      "properties": {
        "encryption": {
          "$ref": "#/definitions/encryption"
        },
        "hash": {
          "$ref": "#/definitions/hash"
        },
        "prf": {
          "$ref": "#/definitions/hash",
          "title": "Pseudo-random Function",
          "description": "Pseudorandom function (PRF) for key derivation"
        },
        "dh": {
          "$ref": "#/definitions/dh"
        },
        "ikelifetime": {
          "type": "number",
          "title": "IKE Lifetime",
          "description": "IKE/ISAKMP SA rekey interval (seconds)",
          "default": 10800
        },
        "dpddelay": {
          "type": "integer",
          "title": "DPD Delay",
          "description": "Dead Peer Detection (DPD) packet sending interval",
          "default": 30
        },
        "dpdtimeout" : {
          "type": "integer",
          "title": "DPD Timeout",
          "default": 150,
          "description": "Terminate IKEv1 connection after a timeout without a response to the DPD packet"
        },
        "dpdaction": {
          "type":"string",
          "title": "DPD Action",
          "description": "Action to perform when connection is broken due to timeout with no response to the DPD packet",
          "enum": ["hold", "restart", "clear", "none"]
        }
      }
    }
  },

  "delete": {
    "exec": "handler",
    "args": ["delete", "ipsec/profile"],
    "reload": true
  },

  "add": {
    "exec": "handler",
    "args": ["add", "ipsec/profile"],
    "merge": true,
    "schema": {
      "required": ["name"],
      "properties": {
        "name": {"$ref": "#/definitions/name"}
      }
    }
  },

  "clean": {
    "exec": "handler",
    "args": ["clean", "ipsec/profile"],
    "confirm": true,
    "reload": true
  },

  "apply": {
    "exec": "handler",
    "args": ["apply", "ipsec/profile"]
  },

  "set": {
    "exec": "handler",
    "args": ["set", "ipsec/profile"]
  },    

  "acquire": {
    "exec": "handler",
    "args": ["get", "ipsec/profile"]
  }
}
