{
  "$schema": "http://json-schema.org/schema#",
  "documentation": ["local", "global"],
  "title": "L2TPv3",
  "description": "L2TPv3 tunneling interfaces",
  "type": "object",
  "showParams": ["local-ip", "remote-ip", "mtu", "encryption"],
  "patternProperties": {
    ".*": {
      "type": "object",
      "title": "L2TPv3 tunnel",
      "description": "L2TPv3 tunnel interface",
      "required": ["remote-ip", "psk", "tunnel-id", "session-id", "peer-tunnel-id", "peer-session-id"],
      "properties": {
        "l2": {
          "type": "boolean",
          "hidden": true,
          "noExport": true
        },

        "proto": {
          "type": "string",
          "hidden": true,
          "noExport": true
        },

        "disabled": {
          "$ref": "/defaults#/definitions/disabled"
        },
        
        "local-ip": {
          "$ref": "/defaults#/definitions/interface-ipaddr",
          "title": "Local IP",
          "description": "Local endpoint address or interface",
          "default": "auto"
        },

        "remote-ip": {
          "$ref": "/defaults#/definitions/host",
          "title": "Remote IP",
          "description": "Remote endpoint (FQDN or IP address)"
        },

        "tunnel-ip": {
          "$ref": "/defaults#/definitions/ipaddr",
          "title": "Tunnel IP",
          "description": "Local tunnel interface IP address"
        },

        "encryption": {
          "$ref": "/defaults#/definitions/encryption",
          "enum": ["none"],
          "modificator": [
            {"if": [{"/defaults/ipsec_installed": true}], "then":{"enum": ["none", "ipsec"]}}
          ]
        },

        "psk": {
          "$ref": "/defaults#/definitions/psk",
          "description": "IPsec pre-shared key for tunnel authentication",
          "modificator": [
            {"if": [{"encryption": "ipsec"}], "then": {"hidden": false}}
          ]
        },

        "macaddr": {
          "$ref": "/defaults#/definitions/macaddr",
          "default": "auto"
        },

        "mtu": {
          "$ref": "/defaults#/definitions/mtu",
          "default": 1458
        },

        "l2spec-type": {
          "type": "string",
          "title": "L2 Spec",
          "description": "Layer 2 header format specification",
          "enum": ["default", "none"]
        },

        "tunnel-id": {
          "type": "number",
          "title": "Tunnel ID",
          "description": "Tunnel identifier",
          "minimum": 1,
          "maximum": 4294967295
        },

        "peer-tunnel-id": {
          "type": "number",
          "title": "Peer Tunnel ID",
          "description": "Remote tunnel identifier",
          "minimum": 1,
          "maximum": 4294967295
        },

        "session-id": {
          "type": "number",
          "title": "Session ID",
          "description": "Tunnel session identifier",
          "minimum": 1,
          "maximum": 4294967295
        },

        "peer-session-id": {
          "type": "number",
          "title": "Peer Session ID",
          "description": "Remote session identifier",
          "minimum": 1,
          "maximum": 4294967295
        },

        "encap": {
          "type": "string",
          "title": "Encapsulation",
          "description": "Protocol encapsulation mode",
          "enum": ["ip", "udp"]
        },

        "udp-dport": {
          "$ref": "/defaults#/definitions/port",
          "title": "Peer UDP Port",
          "description": "Remote peer UDP port for UDP encapsulated",
          "minimum": 1024,
          "default": 9021,
          "hidden": true,
          "modificator": [
            {"if": [{"encap": "udp"}], "then": {"hidden": false}}
          ]
        },

        "udp-sport": {
          "$ref": "/defaults#/definitions/port",
          "title": "UDP Port",
          "description": "UDP port for UDP encapsulation",
          "minimum": 1024,
          "default": 9021,
          "hidden": true,
          "modificator": [
            {"if": [{"encap": "udp"}], "then": {"hidden": false}}
          ]
        }
      }
    }
  },

  "delete": {
    "exec": "subscript/tunnel/tunnel.uc",
    "args": ["delete", "l2tpv3"],
    "reload": true
  },

  "add": {
    "exec": "subscript/tunnel/tunnel.uc",
    "args": ["add", "l2tpv3"],
    "merge": true,
    "schema": {
      "required": ["name"],
      "properties": {
        "name": {
          "$ref": "/defaults#/definitions/name",
          "maxLength": 15
        }
      }
    }
  },

  "apply": {
    "exec": "subscript/tunnel/tunnel.uc",
    "args": ["apply", "l2tpv3"]
  },

  "clean": {
    "exec": "subscript/tunnel/tunnel.uc",
    "args": ["clean", "l2tpv3"],
    "reload": true,
    "confirm": true
  },

  "status": {
    "exec": "subscript/tunnel/tunnel.uc",
    "args": ["status", "l2tpv3"]
  },
  
  "set": {
    "exec": "subscript/tunnel/tunnel.uc",
    "args": ["set", "l2tpv3"]
  },    

  "acquire": {
    "exec": "subscript/tunnel/tunnel.uc",
    "args": ["get", "l2tpv3"]
  }
}
