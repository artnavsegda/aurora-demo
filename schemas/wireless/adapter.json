{
  "$schema": "http://json-schema.org/schema#",
  "documentation": [
    "local",
    "global"
  ],
  "title": "Adapter",
  "description": "Wi-Fi adapter settings",
  "type": "object",
  "showParams": [
    "band",
    "model"
  ],
  "patternProperties": {
    ".*": {
      "type": "object",
      "title": "Radio PHY",
      "properties": {
        "_channels": {
          "type": "array",
          "hidden": true,
          "readOnly": true,
          "items": {
            "type": "number"
          }
        },
        "_txpowers": {
          "type": "array",
          "hidden": true,
          "readOnly": true,
          "items": {
            "type": "number"
          }
        },
        "_htmodes": {
          "type": "array",
          "hidden": true,
          "readOnly": true,
          "items": {
            "type": "string"
          }
        },
        "disabled": {
          "$ref": "/defaults#/definitions/disabled"
        },
        "country": {
          "type": "string",
          "description": "Selecting a country to apply regulatory restrictions",
          "default": "default",
          "cue": [
            "/defaults/wireless_country_list"
          ]
        },
        "band": {
          "type": "string",
          "description": "Wireless frequency range",
          "strictEnum": true,
          "hidden": true,
          "noExport": true
        },
        "allow-legacy-rate": {
          "type": "boolean",
          "title": "Allow 802.11b",
          "description": "Allow pairing with devices that only support 802.11b (11 Mbps)",
          "hidden": true,
          "noExport": true,
          "____modificator": [
            {
              "if": [
                {
                  "band": "2.4GHz"
                }
              ],
              "then": {
                "hidden": false
              }
            }
          ]
        },
        "channels": {
          "type": "array",
          "description": "List of wireless adapter channels",
          "uniqueItems": true,
          "items": {
            "type": "number",
            "cue": [
              "$_channels"
            ],
            "strictEnum": true
          }
        },
        "txpower": {
          "type": "number",
          "description": "Transmit power level",
          "title": "Transmit power",
          "strictEnum": true,
          "default": "auto",
          "cue": [
            "+auto",
            "$_txpowers"
          ]
        },
        "htmode": {
          "type": "string",
          "title": "HT mode",
          "description": "High Throughput (HT) mode",
          "strictEnum": true,
          "cue": [
            "+none",
            "$_htmodes"
          ]
        },
        "_frag_threshold": {
          "type": "boolean",
          "description": "hidden option, frag-threshold is supported (capability WIFI_FRAG_THRESHOLD)",
          "hidden": true,
          "noExport": true
        },
        "frag-threshold": {
          "title": "Fragment threshold",
          "type": "number",
          "minimum": 256,
          "maximum": 2346,
          "default": 2346,
          "description": "The size (bytes) of a packet, above which it is fragmented. Even number",
          "hidden": true,
          "modificator": [
            {
              "if": [
                {
                  "_frag_threshold": true
                }
              ],
              "then": {
                "hidden": false
              }
            }
          ]
        },
        "rts-threshold": {
          "title": "RTS threshold",
          "type": "number",
          "minimum": 0,
          "maximum": 2347,
          "default": 2347,
          "description": "The size (bytes) of a packet, above which the RTS/CTS mechanism is activated"
        },
        "beacon": {
          "type": "number",
          "description": "AP beacon transmission interval (msec)",
          "minimum": 15,
          "maximum": 65535,
          "default": 100
        },
        "capabilities": {
          "hidden": true,
          "noExport": true,
          "type": "array",
          "description": "Fine-tuning high performance mode",
          "items": {
            "type": "string",
            "enum": [
              "LDPC",
              "GF",
              "SHORT-GI-20",
              "SHORT-GI-40",
              "TX-STBC",
              "RX-STBC1",
              "RX-STBC12",
              "RX-STBC123",
              "DELAYED-BA",
              "MAX-AMSDU-7935",
              "DSSS_CCK-40",
              "40-INTOLERANT",
              "LSIG-TXOP-PROT",
              "MAX-MPDU-7991",
              "MAX-MPDU-11454",
              "VHT160",
              "VHT160-80PLUS80",
              "RXLDPC",
              "SHORT-GI-80",
              "SHORT-GI-160",
              "TX-STBC-2BY1",
              "RX-STBC-1",
              "RX-STBC-12",
              "RX-STBC-123",
              "RX-STBC-1234",
              "SU-BEAMFORMER",
              "VHT-TXOP-PS",
              "HTC-VHT",
              "MAX-A-MPDU-LEN-EXP0",
              "MAX-A-MPDU-LEN-EXP1",
              "MAX-A-MPDU-LEN-EXP2",
              "MAX-A-MPDU-LEN-EXP3",
              "MAX-A-MPDU-LEN-EXP4",
              "MAX-A-MPDU-LEN-EXP5",
              "MAX-A-MPDU-LEN-EXP6",
              "MAX-A-MPDU-LEN-EXP7",
              "VHT-LINK-ADAPT2",
              "VHT-LINK-ADAPT3",
              "RX-ANTENNA-PATTERN",
              "TX-ANTENNA-PATTERN"
            ]
          }
        },
        "airtime-fairness": {
          "type": "integer",
          "hidden": true,
          "noExport": true,
          "description": "[Not added, needs driver support] Fair airtime distribution control",
          "enum": [
            1,
            2,
            3,
            7
          ]
        }
      }
    },
    "actions": {
      "scan": {
        "exec": "subscript/wireless/adapter.uc",
        "description": "Search for WiFi networks",
        "args": [
          "scan"
        ],
        "wait": true
      }
    }
  },
  "status": {
    "exec": "subscript/wireless/adapter.uc",
    "args": [
      "status"
    ]
  },
  "apply": {
    "exec": "subscript/wireless/adapter.uc",
    "args": [
      "apply"
    ]
  },
  "set": {
    "exec": "subscript/wireless/adapter.uc",
    "args": [
      "set"
    ]
  },
  "acquire": {
    "exec": "subscript/wireless/adapter.uc",
    "args": [
      "get"
    ]
  }
}